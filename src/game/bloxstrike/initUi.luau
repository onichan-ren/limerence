	local aimbotLink = gameUi.ScopedSection(ragebot, "AIMBOT", 1, "aimbot")
	local aimbotTargetingLink = gameUi.ScopedSection(ragebot, "TARGETING", 1, "aimbotTargeting")
	local aimbotFiltersLink = gameUi.ScopedSection(ragebot, "FILTERS", 1, "aimbotFilters")
	local aimbotPerformanceLink = gameUi.ScopedSection(ragebot, "PERFORMANCE", 1, "aimbotPerformance")
	local aimbotVisualsLink = gameUi.Section(ragebot, "VISUALS", 1, "aimbotVisuals")
	gameUi.Mount(Ragebot, aimbotLink, {
		targetingLink = aimbotTargetingLink,
		filtersLink = aimbotFiltersLink,
		performanceLink = aimbotPerformanceLink,
		visualsLink = aimbotVisualsLink,
	})
