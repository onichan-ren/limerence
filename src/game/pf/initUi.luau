local gameUi = require("@game/gameUi")
local loader = require("@loader/loader")
local PlayerController = require("@feature/player/PlayerController")
local PfPlayer = require("@game/pf/player/PfPlayer")
local pfReplication = require("@game/pf/client/pfReplication")
local Esp = require("@game/pf/feature/visual/esp/Esp")
local SoundESP = require("@game/pf/feature/visual/esp/element/SoundESP")
local RagdollChams = require("@game/pf/feature/visual/chams/RagdollChams")
local Legitbot = require("@game/pf/feature/legitbot/Legitbot")
local RecoilControl = require("@game/pf/feature/legitbot/RecoilControl")
local AimIndicator = require("@game/universal/feature/combat/legitbot/AimIndicator")
local DamageNumber3d = require("@game/pf/feature/visual/damagenumber3d/DamageNumber3d")
local DeathParticles = require("@game/pf/feature/visual/deathparticles/DeathParticles")
local Hitskeletons = require("@game/pf/feature/visual/hitskeletons/Hitskeletons")
local Hitmarker3d = require("@game/pf/feature/visual/hitmarker/Hitmarker3d")
local HitOverlay = require("@game/pf/feature/visual/hitoverlay/HitOverlay")
local Hitmarker = require("@game/pf/feature/visual/hitmarker/Hitmarker")
local Hitchams = require("@game/pf/feature/visual/hitchams/Hitchams")
local Hitsound = require("@game/pf/feature/visual/hitsound/Hitsound")
local HitEffect = require("@game/pf/feature/visual/hiteffect/HitEffect")
local HitLog = require("@game/pf/feature/visual/hurtlog/HitLog")
local WorldAmbience = require("@game/universal/feature/visual/world/WorldAmbience")
local pfMapSource = require("@game/pf/feature/visual/world/pfMapSource")
local gameRegistry = require("@game/gameRegistry")
local DroppedWeaponEsp = require("@game/pf/feature/visual/dropped/DroppedWeaponEsp")
local GrenadePrediction = require("@game/pf/feature/visual/grenade/GrenadePrediction")
local GrenadeWarning = require("@game/pf/feature/visual/grenade/GrenadeWarning")
local Removals = require("@game/pf/feature/visual/removals/Removals")
local ReduceRecoil = require("@game/pf/feature/ragebot/ReduceRecoil")
local InstantAim = require("@game/pf/feature/ragebot/InstantAim")
local KnifeAura = require("@game/pf/feature/ragebot/KnifeAura")
local AntiAim = require("@game/pf/feature/ragebot/AntiAim")
local Ragebot = require("@game/pf/feature/ragebot/Ragebot")
local Backtrack = require("@game/pf/feature/ragebot/Backtrack")
local InstantReload = require("@game/pf/feature/ragebot/InstantReload")
local InstantSwitch = require("@game/pf/feature/ragebot/InstantSwitch")
local AspectRatio = require("@game/pf/feature/visual/camera/AspectRatio")
local CustomCrosshair = require("@game/universal/feature/visual/crosshair/CustomCrosshair")
local Hud = require("@game/universal/feature/visual/hud/Hud")
local MusicHud = require("@game/universal/feature/visual/musichud/MusicHud")
local pfMuzzleOrigin = require("@game/pf/feature/visual/crosshair/pfMuzzleOrigin")
local Tracer = require("@game/pf/feature/visual/tracer/Tracer")
local Impact = require("@game/pf/feature/visual/impact/Impact")
local OverrideFov = require("@game/pf/feature/visual/fov/OverrideFov")
local ViewmodelChanger = require("@game/pf/feature/visual/self/ViewmodelChanger")
local ThirdPerson = require("@game/pf/feature/visual/self/ThirdPerson")
local CustomScope = require("@game/pf/feature/visual/removescope/CustomScope")
local ThirdPersonChams = require("@game/pf/feature/visual/self/ThirdPersonChams")
local ViewmodelChams = require("@game/pf/feature/visual/self/ViewmodelChams")
local Footsteps = require("@game/pf/feature/visual/self/Footsteps")
local DroppedWeaponChams = require("@game/pf/feature/visual/chams/DroppedWeaponChams")
local AccountSpoofer = require("@game/universal/feature/misc/AccountSpoofer")
local PlayerSpoofer = require("@game/universal/feature/misc/PlayerSpoofer")
local StatsSpoofer = require("@game/pf/feature/misc/StatsSpoofer")
local Speed = require("@game/pf/feature/misc/Speed")
local Movement = require("@game/pf/feature/misc/Movement")
local FakeLag = require("@game/pf/feature/misc/FakeLag")
local AutoSpot = require("@game/pf/feature/misc/AutoSpot")
local ReverseTime = require("@game/pf/feature/misc/ReverseTime")
local UnlockAll = require("@game/pf/feature/misc/UnlockAll")
local ServerHopOnKick = require("@game/pf/feature/misc/ServerHopOnKick")
local StaffDetector = require("@game/pf/feature/misc/StaffDetector")
local CustomCharacter = require("@game/pf/feature/misc/CustomCharacter")
local InventoryController = require("@game/pf/feature/inventory/InventoryController")

return function(): ()
	PlayerController.SetPlayerClass(PfPlayer)
	PlayerController.new()
	loader.addDestroyer(PlayerController.Destroy)

	pfMuzzleOrigin.Setup()
	loader.addDestroyer(pfMuzzleOrigin.Destroy)

	loader.mount(pfReplication)

	local assistance = gameUi.Group("ASSISTANCE")

	local ragebot = gameUi.Tab(assistance, "Ragebot", "aim")
	local ragebotLink = gameUi.Section(ragebot, "RAGEBOT", 1, "ragebot")
	gameUi.Mount(Ragebot, ragebotLink)

	local ragebotAntiAim = gameUi.Section(ragebot, "ANTI AIM", 2, "antiAim")
	gameUi.Mount(AntiAim, ragebotAntiAim)

	local ragebotWeapon = gameUi.Section(ragebot, "WEAPON", 2, "weaponr")
	gameUi.Mount(ReduceRecoil, ragebotWeapon)
	gameUi.Mount(InstantAim, ragebotWeapon)
	gameUi.Mount(InstantReload, ragebotWeapon)
	gameUi.Mount(InstantSwitch, ragebotWeapon)

	local ragebotMelee = gameUi.Section(ragebot, "MELEE", 2, "melee")
	gameUi.Mount(KnifeAura, ragebotMelee)

	local legitbot = gameUi.Tab(assistance, "Legitbot", "rifle")
	local legitbotLink = gameUi.ScopedSection(legitbot, "MAIN", 1, "legitbot")
	local targettingLink = gameUi.ScopedSection(legitbot, "TARGETTING", 1, "targetting")
	local aimLink = gameUi.ScopedSection(legitbot, "AIM", 1, "aim")
	local triggerLink = gameUi.ScopedSection(legitbot, "TRIGGER", 2, "trigger")
	local bulletRedirectionLink = gameUi.ScopedSection(legitbot, "BULLET REDIRECTION", 1, "bulletRedirection")
	local recoilLink = gameUi.ScopedSection(legitbot, "RECOIL", 2, "recoil")
	local legitbotVisualsLink = gameUi.ScopedSection(legitbot, "VISUALS", 2, "visuals")
	local backtrackLink = gameUi.Section(legitbot, "BACKTRACK", 2, "backtrack")

	legitbot:UseScope(true)
	gameUi.Mount(AimIndicator, legitbotVisualsLink)
	gameUi.Mount(Legitbot, legitbotLink, {
		targettingLink = targettingLink,
		aimLink = aimLink,
		triggerLink = triggerLink,
		bulletRedirectionLink = bulletRedirectionLink,
		visualsLink = legitbotVisualsLink,
	})
	gameUi.Mount(RecoilControl, recoilLink)
	gameUi.Mount(Backtrack, backtrackLink)
	local visuals = gameUi.Group("VISUALS")
	local visualsTab = gameUi.Tab(visuals, "Visuals", "terrain")
	local players = gameUi.Subtab(visualsTab, "Players", "person")
	local espLink = gameUi.Section(players, "PLAYER ESP", 1, "esp")
	gameUi.Mount(Esp, espLink, { previewLink = espLink })
	SoundESP.setup(espLink)
	RagdollChams.setup(espLink)

	local effectsLink = gameUi.Section(players, "HIT FEEDBACK", 2, "effects")
	gameUi.Mount(DamageNumber3d, effectsLink)
	gameUi.Mount(DeathParticles, effectsLink)
	gameUi.Mount(Hitskeletons, effectsLink)
	gameUi.Mount(Hitmarker3d, effectsLink)
	gameUi.Mount(HitOverlay, effectsLink)
	gameUi.Mount(Hitmarker, effectsLink)
	gameUi.Mount(Hitchams, effectsLink)
	gameUi.Mount(Hitsound, effectsLink)
	gameUi.Mount(HitEffect, effectsLink)
	gameUi.Mount(HitLog, effectsLink)

	local selfLink = gameUi.Section(players, "SELF", 2, "selfEsp")
	gameUi.Mount(ViewmodelChams, selfLink)
	gameUi.Mount(ThirdPersonChams, selfLink)
	gameUi.Mount(CustomCharacter, selfLink)
	gameUi.Mount(Footsteps, selfLink)

	local world = gameUi.Subtab(visualsTab, "World", "globe")
	local ambienceLink = gameUi.Section(world, "AMBIENCE", 1, "modulations")
	gameRegistry.mapSource = pfMapSource
	gameUi.Mount(WorldAmbience, ambienceLink, {
		mapSource = pfMapSource,
	})
	local indicatorsLink = gameUi.Section(world, "INDICATORS", 1, "effects")
	gameUi.Mount(GrenadePrediction, indicatorsLink)
	gameUi.Mount(GrenadeWarning, indicatorsLink)
	indicatorsLink:Options("droppedWeapons", "Dropped Weapons")
	local droppedLink = indicatorsLink:OnKey("droppedWeapons")
	gameUi.Mount(DroppedWeaponEsp, droppedLink)
	gameUi.Mount(DroppedWeaponChams, droppedLink)

	local viewLink = gameUi.Section(world, "VIEW", 2, "overlay")
	gameUi.Mount(CustomScope, viewLink)
	gameUi.Mount(ViewmodelChanger, viewLink)
	gameUi.Mount(CustomCrosshair, viewLink)
	gameUi.Mount(OverrideFov, viewLink)
	gameUi.Mount(ThirdPerson, viewLink)
	gameUi.Mount(AspectRatio, viewLink)
	gameUi.Mount(MusicHud, gameUi.SettingsHudSection("hud"))
	gameUi.Mount(Hud, viewLink)

	local effectsLink2 = gameUi.Section(world, "EFFECTS", 2, "effects")
	gameUi.Mount(Tracer, effectsLink2)
	gameUi.Mount(Impact, effectsLink2)
	gameUi.Mount(Removals, effectsLink2:WithPrefix("removals"))

	local other = gameUi.Group("OTHER")
	local misc = gameUi.Tab(other, "Misc", "bolt")
	local movementLink = gameUi.Section(misc, "MOVEMENT", 1, "movement")
	gameUi.Mount(Movement, movementLink)
	gameUi.Mount(FakeLag, movementLink)
	gameUi.Mount(Speed, movementLink)
	local utilityLink = gameUi.Section(misc, "UTILITY", 2, "utility")
	gameUi.Mount(ServerHopOnKick, utilityLink)
	gameUi.Mount(StaffDetector, utilityLink)
	gameUi.Mount(UnlockAll, utilityLink)
	gameUi.Mount(AutoSpot, utilityLink)
	gameUi.Mount(ReverseTime, utilityLink)
	local spoofingLink = gameUi.Section(misc, "SPOOFING", 2, "spoofing")
	gameUi.Mount(AccountSpoofer, spoofingLink)
	gameUi.Mount(PlayerSpoofer, spoofingLink)
	gameUi.Mount(StatsSpoofer, spoofingLink)

	local inventory = gameUi.Tab(other, "Inventory", "karambit")
	InventoryController.Attach(inventory)
end
