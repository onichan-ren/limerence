local gameUi = require("@game/gameUi")
local loader = require("@loader/loader")
local PlayerController = require("@feature/player/PlayerController")
local ModuleController = require("@game/op1/module/ModuleController")
local StateController = require("@game/op1/state/StateController")
local CharacterController = require("@game/op1/character/CharacterController")
local ClientController = require("@game/op1/client/ClientController")
local WeaponController = require("@game/op1/weapon/WeaponController")
local Op1Player = require("@game/op1/player/Op1Player")
local Esp = require("@game/op1/feature/visual/esp/Esp")
local Legitbot = require("@game/op1/feature/legitbot/Legitbot")
local AimIndicator = require("@game/universal/feature/combat/legitbot/AimIndicator")
local ReduceRecoil = require("@game/op1/feature/ragebot/ReduceRecoil")
local ReduceSpread = require("@game/op1/feature/ragebot/ReduceSpread")
local FasterAim = require("@game/op1/feature/ragebot/FasterAim")
local RunAndGun = require("@game/op1/feature/ragebot/RunAndGun")
local WorldAmbience = require("@game/universal/feature/visual/world/WorldAmbience")
local Tracer = require("@game/op1/feature/visual/tracer/Tracer")
local Impact = require("@game/op1/feature/visual/impact/Impact")
local HitEffect = require("@game/op1/feature/visual/hiteffect/HitEffect")
local HitChams = require("@game/op1/feature/visual/hitchams/HitChams")
local HitSkeletons = require("@game/op1/feature/visual/hitskeletons/HitSkeletons")
local HitOverlay = require("@game/op1/feature/visual/hitoverlay/HitOverlay")
local Hitmarker = require("@game/op1/feature/visual/hitmarker/Hitmarker")
local Hitmarker3d = require("@game/op1/feature/visual/hitmarker3d/Hitmarker3d")
local DamageNumber3d = require("@game/op1/feature/visual/damagenumber3d/DamageNumber3d")
local Hitsound = require("@game/op1/feature/visual/hitsound/Hitsound")
local HitLog = require("@game/op1/feature/visual/hitlog/HitLog")
local GrenadeController = require("@game/op1/grenade/GrenadeController")
local GrenadePrediction = require("@game/op1/feature/visual/grenade/GrenadePrediction")
local GrenadeWarning = require("@game/op1/feature/visual/grenade/GrenadeWarning")
local CameraController = require("@game/op1/camera/CameraController")
local CameraIndicator = require("@game/op1/feature/visual/camera/CameraIndicator")
local DefuserController = require("@game/op1/defuser/DefuserController")
local SmokeController = require("@game/op1/smoke/SmokeController")
local Smoke = require("@game/op1/feature/visual/smoke/Smoke")
local SpectatorList = require("@game/op1/feature/misc/SpectatorList")
local CustomCrosshair = require("@game/universal/feature/visual/crosshair/CustomCrosshair")
local op1MuzzleOrigin = require("@game/op1/feature/visual/crosshair/op1MuzzleOrigin")
local Removals = require("@game/op1/feature/visual/removals/Removals")
local CharacterChams = require("@game/op1/feature/visual/self/CharacterChams")
local ViewmodelChams = require("@game/op1/feature/visual/self/ViewmodelChams")
local ToolChams = require("@game/op1/feature/visual/self/ToolChams")
local ThirdPerson = require("@game/op1/feature/visual/self/ThirdPerson")

return function(): ()
	loader.mount(ModuleController)
	loader.mount(StateController)
	loader.mount(CharacterController)
	loader.mount(ClientController)
	loader.mount(WeaponController)
	loader.mount(GrenadeController)
	loader.mount(CameraController)
	loader.mount(DefuserController)
	loader.mount(SmokeController)

	PlayerController.SetPlayerClass(Op1Player)
	PlayerController.new()
	loader.addDestroyer(PlayerController.Destroy)

	op1MuzzleOrigin.Setup()
	loader.addDestroyer(op1MuzzleOrigin.Destroy)

	local assistance = gameUi.Group("ASSISTANCE")

	local ragebotTab = gameUi.Tab(assistance, "Ragebot", "aim")
	ragebotTab:UseScope(true)
	local weaponsLink = gameUi.ScopedSection(ragebotTab, "WEAPONS", 2, "weapons")
	gameUi.Mount(ReduceRecoil, weaponsLink)
	gameUi.Mount(ReduceSpread, weaponsLink)
	gameUi.Mount(FasterAim, weaponsLink)
	gameUi.Mount(RunAndGun, weaponsLink)

	local legitbotTab = gameUi.Tab(assistance, "Legitbot", "rifle")
	legitbotTab:UseScope(true)
	local legitbotLink = gameUi.ScopedSection(legitbotTab, "MAIN", 1, "legitbot")
	local targettingLink = gameUi.ScopedSection(legitbotTab, "TARGETTING", 1, "targetting")
	local aimLink = gameUi.ScopedSection(legitbotTab, "AIM", 1, "aim")
	local bulletRedirectionLink = gameUi.ScopedSection(legitbotTab, "BULLET REDIRECTION", 1, "bulletRedirection")
	local triggerLink = gameUi.ScopedSection(legitbotTab, "TRIGGER", 2, "trigger")
	local visualsLink = gameUi.ScopedSection(legitbotTab, "VISUALS", 2, "visuals")

	gameUi.Mount(AimIndicator, visualsLink)
	gameUi.Mount(Legitbot, legitbotLink, {
		targettingLink = targettingLink,
		aimLink = aimLink,
		triggerLink = triggerLink,
		visualsLink = visualsLink,
		bulletRedirectionLink = bulletRedirectionLink,
	})

	local visuals = gameUi.Group("VISUALS")
	local visualsTab = gameUi.Tab(visuals, "Visuals", "terrain")
	local players = gameUi.Subtab(visualsTab, "Players", "person")
	local espLink = gameUi.Section(players, "PLAYER ESP", 1, "playerEsp")
	gameUi.Mount(Esp, espLink, { previewLink = espLink })

	local hitFeedbackLink = gameUi.Section(players, "HIT FEEDBACK", 2, "hitFeedback")
	gameUi.Mount(HitSkeletons, hitFeedbackLink)
	gameUi.Mount(Hitmarker3d, hitFeedbackLink)
	gameUi.Mount(DamageNumber3d, hitFeedbackLink)
	gameUi.Mount(HitOverlay, hitFeedbackLink)
	gameUi.Mount(Hitmarker, hitFeedbackLink)
	gameUi.Mount(HitChams, hitFeedbackLink)
	gameUi.Mount(Hitsound, hitFeedbackLink)
	gameUi.Mount(HitEffect, hitFeedbackLink)
	gameUi.Mount(HitLog, hitFeedbackLink)

	local selfLink = gameUi.Section(players, "SELF", 2, "self")
	gameUi.Mount(ToolChams, selfLink)
	gameUi.Mount(ViewmodelChams, selfLink)
	gameUi.Mount(CharacterChams, selfLink)

	local hudLink = gameUi.Section(players, "HUD", 2, "hud")
	gameUi.Mount(SpectatorList, hudLink)
	gameUi.Mount(CustomCrosshair, hudLink)

	local world = gameUi.Subtab(visualsTab, "World", "globe")
	local ambienceLink = gameUi.Section(world, "AMBIENCE", 1, "ambience")
	gameUi.Mount(WorldAmbience, ambienceLink)

	local indicatorsLink = gameUi.Section(world, "INDICATORS", 1, "indicators")
	gameUi.Mount(GrenadePrediction, indicatorsLink)
	gameUi.Mount(GrenadeWarning, indicatorsLink)
	gameUi.Mount(CameraIndicator, indicatorsLink)

	local worldEffectsLink = gameUi.Section(world, "EFFECTS", 2, "effects")
	gameUi.Mount(Tracer, worldEffectsLink)
	gameUi.Mount(Impact, worldEffectsLink)
	gameUi.Mount(Removals, worldEffectsLink:WithPrefix("overlay"))
	gameUi.Mount(Smoke, worldEffectsLink)
	gameUi.Mount(ThirdPerson, worldEffectsLink)
end
