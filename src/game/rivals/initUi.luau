local viewmodelState = require("@game/rivals/viewmodel/viewmodelState")
local Charm = require("@pkg/Charm")

local peek = Charm.peek

return function(): ()
	originState.SetMuzzlePositionProvider(function(): Vector3?
		local vm = peek(viewmodelState._viewmodel)
		if type(vm) == "table" and type(vm.GetMuzzlePosition) == "function" then
			setthreadidentity(2)
			local position = vm.GetMuzzlePosition(vm)
			setthreadidentity(8)
			if typeof(position) == "Vector3" then
				return position
			end
		end
		return nil
	end)

	PlayerController.SetPlayerClass(RivalsPlayer)
	PlayerController.new()
	loader.addDestroyer(PlayerController.Destroy)

	botSource.Start()
	loader.addDestroyer(botSource.Destroy)

	local assistance = gameUi.Group("ASSISTANCE")
	local ragebot = gameUi.Tab(assistance, "Ragebot", "aim")
	ragebot:UseScope(true)
	local ragebotMainLink = gameUi.Section(ragebot, "RAGEBOT", 1, "ragebotMain"):Scoped(true)
	gameUi.Mount(Ragebot, ragebotMainLink)
	local ragebotLink = gameUi.Section(ragebot, "WEAPON", 2, "ragebot")
	gameUi.Mount(NoCooldown, ragebotLink)
	gameUi.Mount(AlwaysBackstab, ragebotLink)
	gameUi.Mount(FullAccuracy, ragebotLink)
	gameUi.Mount(InstantAim, ragebotLink)
	gameUi.Mount(WeaponMods, ragebotLink)
	--gameUi.Mount(NoRecoil, ragebotLink)
	local otherLink = gameUi.Section(ragebot, "OTHER", 2, "other")
	gameUi.Mount(AntiFreeze, otherLink)

	local automationLink = gameUi.Section(ragebot, "AUTOMATION", 1, "automation")
	gameUi.Mount(AutoLoadout, automationLink)
	gameUi.Mount(AutoWeaponBan, automationLink)
	gameUi.Mount(AutoVoteMap, automationLink)
	gameUi.Mount(AutoRespawn, automationLink)
	gameUi.Mount(AutoQueue, automationLink)

	local legitbot = gameUi.Tab(assistance, "Legitbot", "rifle")
	local legitbotLink = gameUi.ScopedSection(legitbot, "MAIN", 1, "legitbot")
	local targettingLink = gameUi.ScopedSection(legitbot, "TARGETTING", 1, "targetting")
	local aimLink = gameUi.ScopedSection(legitbot, "AIM", 1, "aim")
	local triggerLink = gameUi.ScopedSection(legitbot, "TRIGGER", 2, "trigger")
	local bulletRedirectionLink = gameUi.ScopedSection(legitbot, "BULLET REDIRECTION", 1, "bulletRedirection")
	local visualsLink = gameUi.ScopedSection(legitbot, "VISUALS", 2, "visuals"):Global()

	legitbot:UseScope(true)
	gameUi.Mount(ManipBar, visualsLink)
	gameUi.Mount(AimIndicator, visualsLink)
	gameUi.Mount(Legitbot, legitbotLink, {
		targettingLink = targettingLink,
		aimLink = aimLink,
		triggerLink = triggerLink,
		rcsLink = legitbotLink,
		visualsLink = visualsLink,
		bulletRedirectionLink = bulletRedirectionLink,
	})

	local deflectLink = gameUi.Section(legitbot, "DEFLECT", 2, "autoDeflect")
	gameUi.Mount(AutoDeflect, deflectLink)

	--local backtrackLink = gameUi.Section(legitbot, "BACKTRACK", 2, "backtrack")
	--gameUi.Mount(Backtrack, backtrackLink)

	local visuals = gameUi.Group("VISUALS")
	local visualsTab = gameUi.Tab(visuals, "Visuals", "terrain")
	local players = gameUi.Subtab(visualsTab, "Players", "person")
	local espLink = gameUi.Section(players, "PLAYER ESP", 1, "esp")
	gameUi.Mount(Esp, espLink, { previewLink = espLink })
	gameUi.Mount(RagdollChams, espLink:WithPrefix("otherPlayers"))
	gameUi.Mount(FootstepEsp, espLink)

	local effectsLink = gameUi.Section(players, "HIT FEEDBACK", 2, "effects")
	gameUi.Mount(DamageNumber3d, effectsLink)
	gameUi.Mount(DeathParticles, effectsLink)
	gameUi.Mount(Hitskeletons, effectsLink)
	gameUi.Mount(Hitmarker3d, effectsLink)
	gameUi.Mount(HitOverlay, effectsLink)
	gameUi.Mount(Hitmarker, effectsLink)
	gameUi.Mount(Hitchams, effectsLink)
	gameUi.Mount(Hitsound, effectsLink)
	gameUi.Mount(HurtLog, effectsLink)
	gameUi.Mount(HitEffect, effectsLink)
	gameUi.Mount(HitLog, effectsLink)

	local selfEspLink = gameUi.Section(players, "SELF", 2, "selfEsp")
	gameUi.Mount(ForceRareInspects, selfEspLink)
	gameUi.Mount(ViewmodelChams, selfEspLink)
	gameUi.Mount(CharacterChams, selfEspLink)
	gameUi.Mount(CustomCharacter, selfEspLink)
	gameUi.Mount(Footsteps, selfEspLink)
	gameUi.Mount(SelfEsp, selfEspLink)

	local world = gameUi.Subtab(visualsTab, "World", "globe")
	local ambienceLink = gameUi.Section(world, "AMBIENCE", 1, "worldModulations")
	gameRegistry.mapSource = worldMapSource
	gameUi.Mount(WorldAmbience, ambienceLink, {
		mapSource = worldMapSource,
	})
	gameUi.Mount(ParticleColors, ambienceLink:WithPrefix("gameModulations"))

	local worldLink = gameUi.Section(world, "WORLD", 1, "world")
	gameUi.Mount(GrenadeIndicator, worldLink)
	gameUi.Mount(GrenadeWarning, worldLink)
	gameUi.Mount(TransparentWalls, worldLink)
	gameUi.Mount(PlaceableEsp, worldLink)

	local worldEffectsLink = gameUi.Section(world, "EFFECTS", 1, "effects")
	gameUi.Mount(TrajectoryColor, worldEffectsLink)
	gameUi.Mount(Tracer, worldEffectsLink)
	gameUi.Mount(TrailColors, worldEffectsLink)

	local cameraLink = gameUi.Section(world, "CAMERA", 2, "camera")
	gameUi.Mount(ViewmodelChanger, cameraLink)
	gameUi.Mount(ThirdPerson, cameraLink)
	gameUi.Mount(OverrideFov, cameraLink)
	gameUi.Mount(AspectRatio, cameraLink)

	local crosshairLink = gameUi.Section(world, "CROSSHAIR", 2, "crosshair")
	gameUi.Mount(RemoveScope, crosshairLink)
	gameUi.Mount(CustomCrosshair, crosshairLink)

	local hudLink = gameUi.Section(world, "HUD", 2, "hud")
	gameUi.Mount(MusicHud, gameUi.SettingsHudSection("hud"))
	gameUi.Mount(Removals, hudLink)
	gameUi.Mount(Hud, hudLink)

	local other = gameUi.Group("OTHER")
	local inventory = gameUi.Tab(other, "Inventory", "karambit")
	RivalsInventoryController.Attach(inventory)

	local misc = gameUi.Tab(other, "Misc", "bolt")
	local movementLink = gameUi.Section(misc, "MOVEMENT", 1, "movement")
	gameUi.Mount(InfiniteDoubleJump, movementLink)
	gameUi.Mount(DoubleJumpBoost, movementLink)
	gameUi.Mount(SlideBoost, movementLink)
	gameUi.Mount(FakeLag, movementLink)
	gameUi.Mount(Flight, movementLink)
	local utilityLink = gameUi.Section(misc, "UTILITY", 2, "utility")
	gameUi.Mount(CheaterDetector, utilityLink)
	gameUi.Mount(AnimationPlayer, utilityLink)
	gameUi.Mount(ReloadCancel, utilityLink)
	gameUi.Mount(AutoPickup, utilityLink)
	gameUi.Mount(AutoPistols, utilityLink)
	local spoofingLink = gameUi.Section(misc, "SPOOFING", 2, "spoofing")
	gameUi.Mount(AccountSpoofer, spoofingLink)
	gameUi.Mount(DeviceSpoofer, spoofingLink)
	gameUi.Mount(PlayerSpoofer, spoofingLink)
	gameUi.Mount(RegionSpoofer, spoofingLink)
end
