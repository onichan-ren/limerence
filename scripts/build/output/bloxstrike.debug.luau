		cache.outlineColor = snap.color
		cache.outlineTransparency = snap.transparency
	end
	syncColor()
	syncOutlineColor()
	sub(thicknessLink._state, function(v: number): ()
		cache.thickness = v
	end)
	sub(outlineToggleLink._state, function(v: boolean): ()
		cache.outline = v
