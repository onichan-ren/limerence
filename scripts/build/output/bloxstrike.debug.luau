		self.Track(		self,selectionLink.Get(selectionLink,"maxDistance"):OnChange(setMaxDistance))
	end

	self._smoothingCurve = opts.aimLink:OnKey("smoothing"):Get("smoothingCurve")

	local showTrigger = (uiOpts.showTrigger ~= false)
