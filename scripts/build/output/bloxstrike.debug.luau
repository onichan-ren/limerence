function espPreview._buildControls(self: Preview__DARKLUA_TYPE_vK): ()
	local previewLink = self._previewLink
	if not previewLink then
		return
	end

	local submenuElement = previewLink.Submenu(previewLink,"previewState", "Preview State")
	submenuElement.SetVisible(	submenuElement,false)
	self._previewSubmenu = submenuElement
	local stateLink = previewLink.OnKey(previewLink,"previewState")

	self._buildRotationControls(
	self,stateLink)

	local controls = self._controls
	if not controls then
		return
	end

	for _, spec in next, controls do
		local element
		if spec.type == "Dropdown" then
			element = stateLink.Dropdown(stateLink,spec.key, spec.label, spec.options, spec.default)
		elseif spec.type == "Colorpicker" then
			element = stateLink.Colorpicker(stateLink,spec.key, spec.label, spec.default)
		else
			element = stateLink.Toggle(stateLink,spec.key, spec.label, spec.default == true)
		end
		if spec.tip then
			element.SetTip(			element,spec.tip)
		end

		local atomKey = spec.atomKey or spec.key
		local map = spec.map
		self._controlElements[spec.key] = element

		local function handle(newValue: any): ()
			self._controlValues[spec.key] = newValue
			local mapped = newValue
			if map then
				mapped = map(newValue)
			end
			self.SetAtom(			self,atomKey, mapped)
			self._applyModelState(			self)
		end

		local function seed(value: any): ()
			self._controlValues[spec.key] = value
			local mapped = value
			if map then
				mapped = map(value)
			end
			self.SetAtom(			self,atomKey, mapped)
		end

		if spec.type == "Colorpicker" then
			local binding = element._currentColor
			seed((binding :: any):getValue())
			self._controlUnsubs[#self._controlUnsubs + 1] = subscribeToBinding(binding, handle)
		else
			seed(peek(element._state))
			self._controlUnsubs[#self._controlUnsubs + 1] = sub(element._state, handle)
		end
	end
end

