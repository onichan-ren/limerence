	if type(skins) ~= "table" then
		return map
	end
	for _, s in next, skins do
		if type(s) ~= "table" then
			continue
		end
		local weaponName = sharedCatalog.weaponName(s.w)
		if not weaponName then
			continue
		end
		local skinName = sharedCatalog.skinName(s.s)
		if not skinName then
			continue
		end
		map[weaponName] = { skin = skinName }
	end
	return map
end

local function buildLoadout(): { any }
	local out: { any } = {}
	local fakes = peek(inventoryGameState.fakeItems)
	if type(fakes) ~= "table" then
		return out
	end
	local seenWeapon: { [number]: boolean } = {}
	for _, fake in next, fakes do
		if #out >= MAX_WEAPONS then
			break
		end
		if type(fake) ~= "table" then
			continue
		end
		local name = fake.Name
		local skin = fake.Skin
		if type(name) ~= "string" or type(skin) ~= "string" then
			continue
		end
		local w = sharedCatalog.weaponId(name)
		if w == 0 or seenWeapon[w] then
			continue
		end
		local s = sharedCatalog.skinId(skin)
		if s == 0 then
			continue
		end
		seenWeapon[w] = true
		out[#out + 1] = { w = w, s = s, wr = 0, c = 0 }
	end
	return out
