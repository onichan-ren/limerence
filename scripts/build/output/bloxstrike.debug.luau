	local janitor = Janitor.new()
	local record: RagdollRecord__DARKLUA_TYPE_xd = { janitor = janitor, category = category }
	self._ragdolls[ragdoll] = record

	local material = self._categoryMaterial(self,category)
	local color = self._categoryColor(self,category)
	local transparency = self._categoryTransparency(self,category)

	for _, desc in next, ragdoll.QueryDescendants(ragdoll,"Instance") do
		if desc.IsA(desc,"BasePart") then
			self._applyPart(			self,desc :: BasePart, category, material, color, transparency)
		end
