function Atmosphere._hookAtmosphere(self: Atmosphere__DARKLUA_TYPE_yj, atmosphere: Atmosphere__DARKLUA_TYPE_yj): ()
	if self._hookedAtmospheres[atmosphere] then
		return
	end
	hook.addInstance(atmosphere)
	for _, prop in next, BLOCKED_PROPS do
		hook.blockProperty(atmosphere, prop)
	end
	self._hookedAtmospheres[atmosphere] = true
end

function Atmosphere._unhookAtmosphere(self: Atmosphere__DARKLUA_TYPE_yj, atmosphere: Atmosphere__DARKLUA_TYPE_yj): ()
