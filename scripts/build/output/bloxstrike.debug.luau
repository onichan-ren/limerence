	if type(identifier) == "string" and PROFILES[identifier] then
		return identifier
	end
	if type(weapon) == "string" and PROFILES[weapon] then
		return weapon
	end
	local props = equipped.Properties
	if props and props.Class == "Grenade" then
		if type(name) == "string" then
			return name
