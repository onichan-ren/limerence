local function isPlayerWeaponDebrisRoot(inst: Instance): boolean
	if not LocalPlayer then
		return false
	end
	local prefix = LocalPlayer.Name
	return inst.Name == prefix .. "_Weapon" or inst.Name == prefix .. "_WeaponAttachments"
end

local function isUnderWeaponRoot(part: BasePart): boolean
	local current: Instance? = part
	while current do
		if CHARACTER_WEAPON_ROOTS[current.Name] then
			local parent = current.Parent
			if parent and parent.ClassName == "Model" and parent.FindFirstChildOfClass(parent,"Humanoid") then
				return true
			end
		end
		if isPlayerWeaponDebrisRoot(current) then
			return true
		end
		current = current.Parent
	end
	return false
end

local function shouldPatchPart(part: Instance): boolean
	if not part.IsA(part,"BasePart") then
		return false
	end
	local base = part :: BasePart
	if base.Transparency >= 1 or SKIP_PART_NAMES[base.Name] then
		return false
	end
	return isUnderWeaponRoot(base)
end

local function collectWeaponRoots(character: Model?): { Instance }
	local roots: { Instance } = {}
	if character then
		local weaponModel = character.FindFirstChild(character,"WeaponModel")
		local weaponAttachments = character.FindFirstChild(character,"WeaponAttachments")
		if weaponModel then
			roots[#roots + 1] = weaponModel
		end
		if weaponAttachments then
			roots[#roots + 1] = weaponAttachments
		end
	end

	local debris = Workspace.FindFirstChild(Workspace,"Debris")
	if debris and LocalPlayer then
		local equipped = debris.FindFirstChild(debris,LocalPlayer.Name .. "_Weapon")
		local attachments = debris.FindFirstChild(debris,LocalPlayer.Name .. "_WeaponAttachments")
		if equipped then
			roots[#roots + 1] = equipped
		end
		if attachments then
			roots[#roots + 1] = attachments
		end
	end

	return roots
end

