	end
end

function Backtrack._bindPlayer(self: Backtrack__DARKLUA_TYPE_uc, bp: any): ()
	local player: Player = bp.GetPlayer(bp)
	if self._tracks[player] then
		return
	end

	local track: Track__DARKLUA_TYPE_ub = {
		bp = bp,
		buffer = {},
		bufferStart = 1,
		lastSnap = 0,
		ghost = nil,
		ghostParts = {},
		adorns = {},
		charUnsub = function() end,
		aliveUnsub = function() end,
		lastCharacter = nil,
		ghostVisible = nil,
	}
	self._tracks[player] = track

	track.charUnsub = sub(bp.character, function(character: any): ()
		if character == track.lastCharacter then
			return
		end
		track.lastCharacter = character
		self._destroyGhost(		self,track)
		if character then
			self._createGhost(			self,character, track, player)
		end
	end)

	track.aliveUnsub = sub(bp.alive, function(alive: boolean): ()
		if not alive then
			table.clear(track.buffer)
			track.bufferStart = 1
			track.lastSnap = 0
			self._setTrackVisible(			self,track, false)
		end
	end)

	local character = peek(bp.character)
	track.lastCharacter = character
	if character then
		self._createGhost(		self,character, track, player)
	end
end

function Backtrack._unbindPlayer(self: Backtrack__DARKLUA_TYPE_uc, player: Player): ()
	local track = self._tracks[player]
	if not track then
		return
	end
	track.charUnsub()
	track.aliveUnsub()
	self._destroyGhost(	self,track)
	self._tracks[player] = nil
end

function Backtrack._createGhost(self: Backtrack__DARKLUA_TYPE_uc, character: Model, track: Track__DARKLUA_TYPE_ub, player: Player): ()
	local model = instances.new("Model", { Secure = true }, self._folder) :: Model
	local ghostParts: { [string]: BasePart } = {}

	for _, child in next, character.GetChildren(character) do
		if not child.IsA(child,"BasePart") then
			continue
		end
		if child.Transparency ~= 0 then
			continue
		end

		local clone = child.Clone(child) :: BasePart
		for _, c in next, clone.GetChildren(clone) do
			if c.IsA(c,"SpecialMesh") then
				c.TextureId = ""
			else
				c.Destroy(				c)
			end
		end
		if clone.IsA(clone,"MeshPart") then
			clone.TextureID = ""
		end

		clone.Anchored = true
		clone.CanCollide = false
		clone.CanQuery = false
		clone.CanTouch = false
		clone.CastShadow = false
		clone.Transparency = 1
		clone.Material = GHOST_MATERIAL
		clone.Color = self._ghostColor
		clone.Parent = model
		ghostParts[child.Name] = clone

		self._ghostPartMap[clone] = { player = player, partName = child.Name }

		if self._behindWalls then
			track.adorns[clone] = self._createAdorn(self,clone)
		end
	end

	track.ghost = model
	track.ghostParts = ghostParts
	track.ghostVisible = nil
end

function Backtrack._createAdorn(self: Backtrack__DARKLUA_TYPE_uc, part: BasePart): BoxHandleAdornment
	local color = self._ghostColor
	local adorn = instances.new("BoxHandleAdornment", {
		Size = part.Size + GLOW_SIZE_OFFSET,
		AlwaysOnTop = true,
		ZIndex = part.Name == "Head" and 10 or 9,
		Adornee = part,
		Color3 = Color3.new(color.R * GLOW_SCALE, color.G * GLOW_SCALE, color.B * GLOW_SCALE),
		Transparency = GHOST_PART_TRANSPARENCY,
		Visible = part.Transparency < 1,
	}, part) :: BoxHandleAdornment;
	(adorn :: any).Shading = Enum.AdornShading.XRayShaded
	return adorn
end

function Backtrack._setBehindWalls(self: Backtrack__DARKLUA_TYPE_uc, enabled: boolean): ()
	if self._behindWalls == enabled then
		return
	end
	self._behindWalls = enabled

	for _, track in next, self._tracks do
		if enabled then
			for _, part in next, track.ghostParts do
				if not track.adorns[part] then
					track.adorns[part] = self._createAdorn(self,part)
				end
			end
		else
			for part, adorn in next, track.adorns do
				adorn.Destroy(				adorn)
				track.adorns[part] = nil
			end
		end
	end
end

function Backtrack._destroyGhost(self: Backtrack__DARKLUA_TYPE_uc, track: Track__DARKLUA_TYPE_ub): ()
	if track.ghost then
		for _, part in next, track.ghostParts do
			self._ghostPartMap[part] = nil
		end
		track.ghost:Destroy()
		track.ghost = nil
		track.ghostParts = {}
		table.clear(track.adorns)
	end
end

function Backtrack._setTrackVisible(self: Backtrack__DARKLUA_TYPE_uc, track: Track__DARKLUA_TYPE_ub, visible: boolean): ()
	if track.ghostVisible == visible then
		return
	end
	track.ghostVisible = visible
	local transparency = (visible and GHOST_PART_TRANSPARENCY or 1)
	for _, part in next, track.ghostParts do
		part.Transparency = transparency
		local adorn = track.adorns[part]
		if adorn then
			adorn.Visible = visible
		end
		if not visible then
			part.CanQuery = false
		end
	end
end

function Backtrack._refreshGhostColor(self: Backtrack__DARKLUA_TYPE_uc): ()
	local color = self._ghostColor
	local glowColor = Color3.new(color.R * GLOW_SCALE, color.G * GLOW_SCALE, color.B * GLOW_SCALE)
	for _, track in next, self._tracks do
		for _, part in next, track.ghostParts do
			part.Color = color
		end
		for _, adorn in next, track.adorns do
			adorn.Color3 = glowColor
		end
	end
end

Backtrack._tick = LPH_NO_VIRTUALIZE(function(self: Backtrack__DARKLUA_TYPE_uc): ()
	local now = os.clock()
	local localTeam = ClientController.GetTeam()
	local rawDelay = self._delayEl:Peek() or 200
	local delaySec = (rawDelay <= 0 and peek(sessionState.ping) * 2 / 1000 or rawDelay / 1000)
	self._lastDelaySec = delaySec
	local visual = self._visualEl:Peek()
	local retention = math.max(MAX_DELAY_SEC, delaySec + 0.5)
	local cutoff = now - retention
	local hiddenTransparency = 1
	local visibleTransparency = GHOST_PART_TRANSPARENCY

	for _, track in next, self._tracks do
		local bp = track.bp
		if bp.GetTeam(bp) == localTeam then
			self._setTrackVisible(			self,track, false)
			continue
		end

		local alive = bp.IsAlive(bp)

		if alive and now - track.lastSnap >= SNAPSHOT_INTERVAL then
			track.lastSnap = now
			local parts = peek(bp.parts)
			local cframes: { [string]: CFrame } = {}
			for name, part in next, parts do
				if part.IsA(part,"BasePart") then
					cframes[name] = part.CFrame
				end
			end
			if next(cframes) then
				local buffer = track.buffer
				buffer[#buffer + 1] = { time = now, cframes = cframes }
