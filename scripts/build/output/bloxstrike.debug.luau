		NetworkController.UnhookPacket("Inventory", "ThrowGrenade")
	end, true)

	self._janitor:Add(
		RunService.PreRender:Connect(LPH_NO_VIRTUALIZE(function(dt: number): ()
			self._renderTick(			self,dt)
		end)),
		"Disconnect"
	)
end

function GrenadeHelper._disable(self: GrenadeHelper__DARKLUA_TYPE_z0): ()
	if not self._enabled then
		return
	end
	self._enabled = false
	self._endExecute(	self)
	self._cancelRecording(	self)
	self._override = nil
	self._hovered = nil
	self._janitor:Cleanup()
	self._markers:HideAll()
end

