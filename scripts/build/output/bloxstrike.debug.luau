function ragebotApi.GetInFlightStats(player: any, now: number?): (number, number)
	local shots = _inFlightDamage[player]
	if not shots then
		return 0, 0
	end
	local clock = now or tick()
	local ttl = inFlightTtl()
	local n = #shots
	local writeIdx = 1
	local total = 0
	for i = 1, n do
		local shot = shots[i]
		if clock - shot.time <= ttl then
