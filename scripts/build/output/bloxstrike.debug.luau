function lineupStore.Load(): ()
	if _loaded then
		return
	end
	_loaded = true
	if not isfile(FILE_PATH) then
		return
	end
	local ok, decoded = pcall(function()
		return HttpService.JSONDecode(HttpService,readfile(FILE_PATH))
	end)
	if ok then
		hydrate(decoded)
	end
end

function lineupStore.GetForMap(map: string): { Lineup__DARKLUA_TYPE_zX }
	lineupStore.Load()
	return _maps[map] or EMPTY
end

function lineupStore.Find(map: string, name: string): Lineup__DARKLUA_TYPE_zX?
	local list = lineupStore.GetForMap(map)
	for i = 1, #list do
		if list[i].name == name then
			return list[i]
		end
	end
	return nil
end

function lineupStore.UniqueName(map: string, base: string): string
	if not lineupStore.Find(map, base) then
		return base
	end
	local index = 2
	while lineupStore.Find(map, string.format('%s %s', tostring(base), tostring(index))) do
		index += 1
	end
	return string.format('%s %s', tostring(base), tostring(index))
end

function lineupStore.Add(map: string, lineup: Lineup__DARKLUA_TYPE_zX): ()
	lineupStore.Load()
	setAnchor(lineup)
	local list = _maps[map]
	if not list then
		list = {}
		_maps[map] = list
	end
	list[#list + 1] = lineup
	save()
	lineupStore.Changed:Fire(map)
end

function lineupStore.Rename(map: string, oldName: string, newName: string): boolean
	lineupStore.Load()
	if newName == "" or oldName == newName then
		return false
	end
	local lineup = lineupStore.Find(map, oldName)
	if not lineup then
		return false
	end
	lineup.name = lineupStore.UniqueName(map, newName)
	save()
	lineupStore.Changed:Fire(map)
	return true
end

function lineupStore.Remove(map: string, name: string): boolean
	lineupStore.Load()
	local list = _maps[map]
	if not list then
		return false
	end
	for i = 1, #list do
		if list[i].name == name then
			table.remove(list, i)
			if #list == 0 then
				_maps[map] = nil
			end
			save()
			lineupStore.Changed:Fire(map)
			return true
		end
	end
	return false
end

return lineupStore
