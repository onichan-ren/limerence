		LayoutOrder = 2,
		GroupTransparency = enterBind.map(enterBind,function(value: number)
			return 1 - value
		end),
		Position = enterBind.map(enterBind,function(value: number)
			return UDim2.fromOffset(0, math.floor((1 - value) * -6))
		end),
	}, {
		UICorner = e("UICorner", {
			CornerRadius = UDim.new(0, 5),
		}),
