local ExtrasGroup = React.memo(function(props: ExtrasGroupProps__DARKLUA_TYPE_qG): Element__DARKLUA_TYPE_ht<any>
	local fadeBind, fadeSpring = useSpring(0, SPRING.smoothPrecise)
	local hidden, setHidden = useState(not props.Visible)

	useEffect(function()
		if props.Visible then
			setHidden(false)
			fadeSpring.setGoal(			fadeSpring,1)
			return
		end
		fadeSpring.setGoal(		fadeSpring,0)
		local handle = task.delay(0.5, function()
			setHidden(true)
		end)
		return function()
			task.cancel(handle)
		end
	end, { props.Visible })

	local naturalHeight, setNaturalHeight = useState(0)
	local innerRef = useRef(nil :: GuiObject?)

	useEffect(function()
		local inner = innerRef.current
		if not inner then
			return
		end
		local function update(): ()
			local h = inner.AbsoluteSize.Y
			if h > 0 then
				setNaturalHeight(h)
			end
		end
		update()
		local conn = inner.GetPropertyChangedSignal(inner,"AbsoluteSize"):Connect(update)
		return function()
			conn.Disconnect(			conn)
		end
	end, {})

	local groupTransparency = fadeBind.map(fadeBind,function(v: number)
		return 1 - v
	end)

	local groupPosition = fadeBind.map(fadeBind,function(v: number)
		return UDim2.new(0, 0, 0, math.floor((1 - v) * -6))
	end)

	local outerSize = fadeBind.map(fadeBind,function(v: number)
		return UDim2.new(1, 0, 0, math.max(0, math.floor(v * naturalHeight)))
	end)

	local rendered: { [string]: Element__DARKLUA_TYPE_ht<any> } = {
		UIListLayout = e("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}),
		UIPadding = e("UIPadding", {
			PaddingLeft = UDim.new(0, 2),
			PaddingRight = UDim.new(0, 2),
			PaddingTop = UDim.new(0, 1),
			PaddingBottom = UDim.new(0, 2),
		}),
		Heading = e("TextLabel", {
			BackgroundTransparency = 1,
			Text = string.upper(props.Label),
			TextColor3 = props.MutedColor,
			TextSize = 10,
			FontFace = FileController.Get("font", "semi_bold"),
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 11),
			LayoutOrder = 0,
		}),
	}
	for index, element in next, props.Extras do
		rendered[string.format('E_%s', tostring(index))] = element.Render(element,index, { textOffsetY = -1})
	end

	return e("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = not hidden,
		Size = outerSize,
		LayoutOrder = props.LayoutOrder,
	}, {
