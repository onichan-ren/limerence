setmetatable(CustomCharacterOverlay, { __index = BaseFeature })

local function isExcludedReal(instance: Instance, excluded: { [string]: true }): boolean
	local current = instance.Parent
	while current do
		if excluded[current.Name] then
			return true
		end
		current = current.Parent
	end
	return false
end

local function resolveUserId(value: string): number?
	local id = tonumber(value)
	if id then
		return id
	end

	local ok, resolved = pcall(function()
		return Players.GetUserIdFromNameAsync(Players,value)
	end)
	if ok and type(resolved) == "number" then
		return resolved
	end
	return nil
end

function CustomCharacterOverlay.new(link: Linker__DARKLUA_TYPE_tm, opts: CustomCharacterOverlayOpts__DARKLUA_TYPE_zs): CustomCharacterOverlay__DARKLUA_TYPE_zt
	local self = BaseFeature.new() :: any
	setmetatable(self, CustomCharacterOverlay)

	self._opts = opts
	self._excludedRealAncestors = opts.excludedRealAncestors or {}
	self._enabled = false
	self._customConstraintInstances = {}
	self._constraintInstances = {}
	self._updateTransforms = {}
	self._parts = {}
	self._fakeDecals = {}
	self._fakeDecalOriginal = {}
	self._fakeHidden = false
	self._realInstances = {}
	self._realHidden = false
	self._generation = 0

	link.Toggle(
	link,"customCharacter", "Custom Character", false):SetTip({
		title = "Custom Character",
		body = "Replaces your character with a custom one.",
	})

	local featureLink = link.OnKey(link,"customCharacter")
	featureLink.Submenu(	featureLink,"opts", "Custom Character")
	local optionsLink = featureLink.OnKey(featureLink,"opts")

	optionsLink.Textbox(
	optionsLink,"target", "Player", "", "Username or user id"):SetTip({
		title = "Player",
		body = "Username or user id of the avatar to copy.",
	})

	self.Track(
	self,link.Get(link,"customCharacter"):OnChange(function(state: boolean): ()
		if state then
			self.enable(			self)
		else
			self.disable(			self)
		end
	end))

	self._optionsLink = optionsLink

	self.Track(
	self,optionsLink.Get(optionsLink,"target"):OnChange(function(value: string): ()
		if self._enabled then
			self._createOrUpdateModel(			self,value)
		end
	end))

	if link.Get(link,"customCharacter"):Peek() then
		self.enable(		self)
	end

	return self
end

function CustomCharacterOverlay.enable(self: CustomCharacterOverlay__DARKLUA_TYPE_zt)
	if self._enabled then
		return
	end

	self._enabled = true
	self._createOrUpdateModel(	self,self._optionsLink:Get("target"):Peek())

	local janitor = Janitor.new()
	self._activeJanitor = janitor

	janitor.Add(
	janitor,function()
		if self._customCharacterJanitor then
			self._customCharacterJanitor:Destroy()
			self._customCharacterJanitor = nil
		end

		if self._characterJanitor then
			self._characterJanitor:Destroy()
			self._characterJanitor = nil
		end
	end, true)

	janitor.Add(
	janitor,sub(self._opts.characterAtom, function(character: Model?): ()
		self._onCharacterChanged(		self,character)
	end))

	janitor.Add(

	janitor,		RunService.PreRender:Connect(LPH_NO_VIRTUALIZE(function()
			self._update(			self)
		end)),
		"Disconnect"
	)

	janitor.Add(

	janitor,		RunService.PreSimulation:Connect(LPH_NO_VIRTUALIZE(function()
			local parts = self._parts
			for _, part in next, parts do
				part.CanCollide = false
				part.CanQuery = false
			end
		end)),
		"Disconnect"
	)

	self._onCharacterChanged(
	self,peek(self._opts.characterAtom))
end

function CustomCharacterOverlay.disable(self: CustomCharacterOverlay__DARKLUA_TYPE_zt)
	if not self._enabled then
		return
	end

	self._enabled = false

	if self._customCharacterJanitor then
		self._customCharacterJanitor:Destroy()
		self._customCharacterJanitor = nil
	end

	if self._activeJanitor then
		self._activeJanitor:Destroy()
		self._activeJanitor = nil
	end

	if self._characterJanitor then
		self._characterJanitor:Destroy()
		self._characterJanitor = nil
	end

	local visibleModelAtom = self._opts.visibleModelAtom
	if visibleModelAtom then
		visibleModelAtom(nil)
	end
end

function CustomCharacterOverlay._createOrUpdateModel(self: CustomCharacterOverlay__DARKLUA_TYPE_zt, value: string)
	if not value then
		return
	end

	local target = value.gsub(value,"^%s+", ""):gsub("%s+$", "")
	if target == "" then
		return
	end

	local resolved = resolveUserId(target)
	local userId = resolved or 1

	if self._customCharacterJanitor then
		self._customCharacterJanitor:Destroy()
		self._customCharacterJanitor = nil
	end

	local customCharacterJanitor = Janitor.new()
	self._customCharacterJanitor = customCharacterJanitor

	self._generation += 1
	local generation = self._generation

	task.spawn(function()
		local description = Players.GetHumanoidDescriptionFromUserIdAsync(Players,userId)
		local customCharacter = Players.CreateHumanoidModelFromDescriptionAsync(Players,description, RIG_TYPE)
		customCharacter.SetAttribute(		customCharacter,"PersistentDebris", true)

		local modelAtom = self._opts.modelAtom
		local visibleModelAtom = self._opts.visibleModelAtom

		local function destroyModel()
			if modelAtom and peek(modelAtom) == customCharacter then
				modelAtom(nil)
			end
			if visibleModelAtom and peek(visibleModelAtom) == customCharacter then
				visibleModelAtom(nil)
			end
			customCharacter.Destroy(			customCharacter)
		end

		local function destroyOwned()
			if self._customCharacter == customCharacter then
				table.clear(self._parts)
				table.clear(self._fakeDecals)
				table.clear(self._fakeDecalOriginal)
				table.clear(self._customConstraintInstances)
				self._customCharacter = nil
				self._fakeHumanoid = nil
				self._fakeRoot = nil
			end
			destroyModel()
		end

		if generation ~= self._generation or not self._enabled then
			destroyModel()
			return
		end

		customCharacterJanitor.Add(
		customCharacterJanitor,function()
			destroyOwned()
		end, true)

		local humanoid = customCharacter.WaitForChild(customCharacter,"Humanoid", 5)

		humanoid.EvaluateStateMachine = false
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

		local animateScript = customCharacter.WaitForChild(customCharacter,"Animate", 5)
		animateScript.Destroy(		animateScript)

		local humanoidRootPart = customCharacter.WaitForChild(customCharacter,"HumanoidRootPart", 5)
		humanoidRootPart.Anchored = true

		self._fakeHidden = true

		customCharacterJanitor.Add(

		customCharacterJanitor,			customCharacter.DescendantAdded:Connect(function(instance: Instance)
				self._processInstance(				self,instance, false)
			end),
			"Disconnect"
		)

		for _, instance in customCharacter.QueryDescendants(customCharacter,"Instance") do
			self._processInstance(			self,instance, false)
		end

		customCharacter.Parent = ensureFolder()

		self._customCharacter = customCharacter
		self._fakeHumanoid = humanoid
		self._fakeRoot = humanoidRootPart
		if modelAtom then
			modelAtom(customCharacter)
		end
	end)
end

function CustomCharacterOverlay._onCharacterChanged(self: CustomCharacterOverlay__DARKLUA_TYPE_zt, character: Model?)
	if self._characterJanitor then
		self._characterJanitor:Destroy()
		self._characterJanitor = nil
	end

	if self._enabled then
		local customCharacter = self._customCharacter
		if not customCharacter or not customCharacter.IsDescendantOf(customCharacter,Workspace) then
			self._createOrUpdateModel(			self,self._optionsLink:Get("target"):Peek())
		end
	end

	if not character then
		return
	end

	local characterJanitor = Janitor.new()
	self._characterJanitor = characterJanitor

	characterJanitor.Add(
	characterJanitor,function()
		self._setRealHidden(		self,false)
		table.clear(self._constraintInstances)
		table.clear(self._realInstances)
	end, true)

	characterJanitor.Add(

	characterJanitor,		character.DescendantAdded:Connect(function(instance: Instance)
			self._processInstance(			self,instance, true)
		end),
		"Disconnect"
	)

	characterJanitor.Add(

	characterJanitor,		character.DescendantRemoving:Connect(function(instance: Instance)
			(self._realInstances :: any)[instance] = nil
		end),
		"Disconnect"
	)

	for _, instance in character.QueryDescendants(character,"Instance") do
		self._processInstance(		self,instance, true)
	end
end

function CustomCharacterOverlay._processInstance(self: CustomCharacterOverlay__DARKLUA_TYPE_zt, instance: Instance, realCharacter: boolean)
	if not realCharacter then
		if instance.IsA(instance,"BasePart") then
			local part = instance :: BasePart
			part.CanCollide = false
			part.CanQuery = false
			part.LocalTransparencyModifier = self._fakeHidden and 1 or 0
			table.insert(self._parts :: any, part)
		elseif instance.IsA(instance,"Decal") or instance.IsA(instance,"Texture") then
			local decal = instance :: Decal
