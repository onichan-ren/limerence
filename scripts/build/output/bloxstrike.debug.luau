function RagdollChams._restoreAll(self: RagdollChams__DARKLUA_TYPE_xe): ()
	local parts: { BasePart } = {}
	for part in next, self._patched do
		parts[#parts + 1] = part
	end
	for _, part in next, parts do
		self._restorePart(		self,part)
	end
end

function RagdollChams.Enable(self: RagdollChams__DARKLUA_TYPE_xe): ()
	if self._enabled then
		return
	end
	self._enabled = true

	local janitor = Janitor.new()
	self._activeJanitor = janitor

	janitor.Add(

	janitor,		CollectionService.GetInstanceAddedSignal(		CollectionService,RAGDOLL_TAG):Connect(function(inst: Instance): ()
			self._attachRagdoll(			self,inst)
		end),
		"Disconnect"
	)

	janitor.Add(

	janitor,		CollectionService.GetInstanceRemovedSignal(		CollectionService,RAGDOLL_TAG):Connect(function(inst: Instance): ()
			self._detachRagdoll(			self,inst)
		end),
		"Disconnect"
	)

	for _, inst in next, CollectionService.GetTagged(CollectionService,RAGDOLL_TAG) do
		self._attachRagdoll(		self,inst)
	end

	local settingsLink = self._settingsLink
	if settingsLink then
		for i = 1, #CATEGORY_ORDER do
			local cat: CategoryId__DARKLUA_TYPE_xb = CATEGORY_ORDER[i]
			local picker: any = settingsLink.Get(settingsLink,cat .. "Color")
			local materialEl: any = settingsLink.OnKey(settingsLink,cat .. "MaterialOpts"):Get("material")
