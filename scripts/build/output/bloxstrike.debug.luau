		return segments
	end

	local sx = canvasSize.X
	local sy = canvasSize.Y

	for i = 1, #points - 1 do
		local p1 = points[i]
		local p2 = points[i + 1]

		local px1 = p1.x * sx
		local py1 = (1 - p1.y) * sy
		local px2 = p2.x * sx
		local py2 = (1 - p2.y) * sy

		local dx = px2 - px1
		local dy = py2 - py1
		local length = math.sqrt(dx * dx + dy * dy)
		if length <= 0 then
			continue
		end

		segments[string.format('Seg_%s', tostring(i))] = e("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((px1 + px2) / 2, (py1 + py2) / 2),
			Size = UDim2.fromOffset(length + 1, CURVE_THICKNESS),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = curveColor,
			BorderSizePixel = 0,
			ZIndex = 2,
		})
	end

	return segments
end

