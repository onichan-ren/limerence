	if (def :: any).Class ~= "Weapon" or (def :: any).MuzzleType == "Zeus x27" then
		return 0, false
	end

	local maxRounds = (def :: any).Rounds
	if type(maxRounds) ~= "number" or maxRounds <= 0 then
