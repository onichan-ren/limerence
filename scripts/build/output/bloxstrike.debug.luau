	if previewAtoms then
		for key, value in next, previewAtoms do
			seed[key] = value
		end
	end
	if controls then
		for _, spec in next, controls do
			local atomKey = spec.atomKey or spec.key
			local value = spec.default
			if spec.map then
				value = spec.map(value)
			end
			seed[atomKey] = value
		end
