	NotifyController.Push({
		title = "Deleted config",
		subtext = name,
		icon = "trash",
		duration = 2,
	})
	return true
end

function ConfigController.ListConfigs(): { string }
	local names: { string } = {}

	local dir = configDir()
	if not isfolder(dir) then
		return names
	end

	for _, path in next, listfiles(dir) do
		local name = path.match(path,"([^/\\]+)%.json$")
		if name then
			table.insert(names, name)
		end
	end

	return names
end

