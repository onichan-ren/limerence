		local color = self._categoryColor(self,category)
		local transparency = self._categoryTransparency(self,category)

		for part, entry in next, self._patched do
			if entry.category == category then
				part.Material = material
				part.Color = color
				part.Transparency = transparency
			end
		end

		for ragdoll, record in next, self._ragdolls do
			if record.category == category and ragdoll.ClassName == "Model" then
				for _, desc in next, ragdoll.QueryDescendants(ragdoll,"Instance") do
					if desc.IsA(desc,"BasePart") then
