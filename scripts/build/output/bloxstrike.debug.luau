		task.cancel(leavingTimers[id])
	end
	leavingTimers[id] = task.delay(LEAVE_DURATION, function()
		leavingTimers[id] = nil
		removeFromDisplay(id)
	end)
end

local function transitionToLeaving(id: string): ()
