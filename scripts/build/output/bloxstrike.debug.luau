local function snippet(body: string?): string
	if not body or body == "" then
		return "<empty>"
	end
	local trimmed = string.gsub(body, "%s+", " ")
	if #trimmed > 120 then
		return string.sub(trimmed, 1, 117) .. "..."
	end
	return trimmed
end

local function fetchBody(url: string): (boolean, string)
	local ok, response = pcall(request, {
		Url = url,
		Method = "GET",
		Headers = {
			["Accept"] = "application/json",
			["Cache-Control"] = "no-cache",
		},
	})
	if not ok then
		return false, tostring(response)
	end
	local statusCode = response.StatusCode or 0
	local body = response.Body or ""
	if statusCode < 200 or statusCode >= 300 then
		return false, string.format('HTTP %s %s: %s', tostring(statusCode), tostring(response.StatusMessage or ""), tostring(body))	
end
	return true, body
end

function serverDataSource.fetchPage(placeId: number, cursor: string?): ServerPage__DARKLUA_TYPE_uO
	local url = serverDataSource.buildUrl(placeId, cursor)

	local ok, body = fetchBody(url)
	if not ok then
		return {
			rows = {},
			nextCursor = nil,
			previousCursor = nil,
			error = body,
		}
	end

	if type(body) ~= "string" or body == "" then
		return {
			rows = {},
			nextCursor = nil,
			previousCursor = nil,
			error = "Empty response from server",
		}
	end

	local decodeOk, decoded: any = pcall(function(): any
		return HttpService.JSONDecode(HttpService,body)
	end)

	if not decodeOk or type(decoded) ~= "table" then
		return {
			rows = {},
			nextCursor = nil,
			previousCursor = nil,
			error = string.format('Failed to parse response: %s', tostring(snippet(body))),
		}
	end

	if type(decoded.errors) == "table" and decoded.errors[1] then
		local first = decoded.errors[1]
		local message = (type(first) == "table" and first.message) or "API error"
		return {
			rows = {},
			nextCursor = nil,
			previousCursor = nil,
			error = tostring(message),
		}
	end

	local rows: { ServerEntry__DARKLUA_TYPE_uN } = {}
	if type(decoded.data) == "table" then
		for _, entry in next, decoded.data do
			if type(entry) == "table" and entry.id ~= nil then
				table.insert(rows, entry)
			end
		end
	end

	return {
		rows = rows,
		nextCursor = decoded.nextPageCursor,
		previousCursor = decoded.previousPageCursor,
	}
end

