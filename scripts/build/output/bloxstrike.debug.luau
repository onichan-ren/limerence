	janitor.Add(

	janitor,		ragdoll.DescendantAdded:Connect(function(desc: Instance): ()
			if desc.IsA(desc,"BasePart") then
				self._applyPart(				self,desc :: BasePart, category, material, color, transparency)
			end
		end),
		"Disconnect"
	)

	janitor.Add(

	janitor,		ragdoll.DescendantRemoving:Connect(function(desc: Instance): ()
			if desc.IsA(desc,"BasePart") and self._patched[desc] then
				self._patched[desc] = nil
			end
		end),
		"Disconnect"
	)
end

function RagdollChams._detachRagdoll(self: RagdollChams__DARKLUA_TYPE_xe, ragdoll: Instance): ()
	local record = self._ragdolls[ragdoll]
	if not record then
		return
	end
	self._ragdolls[ragdoll] = nil
	record.janitor:Destroy()

	if ragdoll.ClassName == "Model" then
		for _, desc: any in next, ragdoll.QueryDescendants(ragdoll,"Instance") do
			if desc.IsA(desc,"BasePart") and self._patched[desc] then
				self._restorePart(				self,desc :: BasePart)
			end
		end
	end
