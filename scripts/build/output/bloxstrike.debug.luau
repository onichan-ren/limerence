local function buildSelectionLabel(items: { Item__DARKLUA_TYPE_rT }, selectedId: string?): string
	if not selectedId then
		return ""
	end
	for _, it in items do
		if it.id == selectedId then
			return it.name or it.id
		end
	end
	return ""
end

