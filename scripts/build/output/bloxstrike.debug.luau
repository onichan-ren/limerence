function Legitbot._setRcsActive(self: Legitbot__DARKLUA_TYPE_yG, active: boolean): ()
	if active then
		if not self._rcsBound then
			self._rcsConn = RunService.PreRender:Connect(LPH_NO_VIRTUALIZE(function(dt)
				self._rcsTick(				self,dt)
			end))
			self._rcsBound = true
		end
