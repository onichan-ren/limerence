			ref = innerRef,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Position = groupPosition,
			GroupTransparency = groupTransparency,
		}, rendered),
	})
end)








