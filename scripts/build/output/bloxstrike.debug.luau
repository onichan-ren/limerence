local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function buildLut(points: { Point__DARKLUA_TYPE_rM }): { number }
	local lut = table.create(LUT_SIZE)

	if #points == 0 then
		for i = 1, LUT_SIZE do
			lut[i] = 0
		end
		return lut
	end

	if #points == 1 then
		for i = 1, LUT_SIZE do
			lut[i] = points[1].y
		end
		return lut
	end

	for i = 0, LUT_SIZE - 1 do
		local x = i / (LUT_SIZE - 1)

		local segIdx = #points - 1
		for j = 1, #points - 1 do
			if x <= points[j + 1].x then
				segIdx = j
				break
			end
		end

		local p1 = points[segIdx]
		local p2 = points[segIdx + 1]
		local segLen = p2.x - p1.x
		local t = segLen > 0 and ((x - p1.x) / segLen) or (0)

		lut[i + 1] = math.clamp(lerp(p1.y, p2.y, t), 0, 1)
	end

	return lut
end

local function sortPoints(points: { Point__DARKLUA_TYPE_rM }): { Point__DARKLUA_TYPE_rM }
	local copy = table.clone(points)
	table.sort(copy, function(a, b)
