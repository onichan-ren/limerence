local compactBuffer = LPH_NO_VIRTUALIZE(function(track: Track__DARKLUA_TYPE_ub): ()
	local buffer = track.buffer
	local start = track.bufferStart
	if start <= 1 then
		return
	end
	local n = #buffer
	local newLen = n - start + 1
	if newLen <= 0 then
		table.clear(buffer)
		track.bufferStart = 1
		return
	end
	for i = 1, newLen do
		buffer[i] = buffer[start + i - 1]
	end
	for i = newLen + 1, n do
		buffer[i] = nil
	end
	track.bufferStart = 1
end)

local getHistoricalCFrames = LPH_NO_VIRTUALIZE(
	function(buffer: { Snapshot__DARKLUA_TYPE_ua }, startIdx: number, delay: number): { [string]: CFrame }?
		local n = #buffer
		if n < startIdx then
			return nil
		end
		local target = os.clock() - delay
		if buffer[n].time <= target then
			return buffer[n].cframes
		end
		if buffer[startIdx].time >= target then
			return buffer[startIdx].cframes
		end
		local lo, hi = startIdx, n
		while lo + 1 < hi do
			local mid = math.floor((lo + hi) / 2)
			if buffer[mid].time < target then
				lo = mid
			else
				hi = mid
			end
		end
		if math.abs(buffer[lo].time - target) <= math.abs(buffer[hi].time - target) then
			return buffer[lo].cframes
		end
		return buffer[hi].cframes
	end
)

function Backtrack.new(link: Linker__DARKLUA_TYPE_tm): Backtrack__DARKLUA_TYPE_uc
