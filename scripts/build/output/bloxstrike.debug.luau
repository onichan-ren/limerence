	hook.baseState = initialState
	hook.memoizedState = hook.baseState

	local queue: UpdateQueue__DARKLUA_TYPE_mD<S, A> = {
		pending = nil,
		dispatch = nil,
		lastRenderedReducer = reducer,
		lastRenderedState = initialState :: any,
	}
	hook.queue = queue

	
	
	local cRF = currentlyRenderingFiber
	
	local dispatch: Dispatch__DARKLUA_TYPE_mI<A> = function(action, ...)
		
		dispatchAction(cRF, queue :: UpdateQueue__DARKLUA_TYPE_mD<any, any>, action, ...)
	end :: any
