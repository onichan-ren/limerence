	local previous = self._model
	self._model = model
	model.Parent = self._worldModel
	if previous and previous ~= model and typeof(previous) == "Instance" then
		previous.Destroy(		previous)
	end

	local hrp = (self._resolveHrp and self._resolveHrp(model)) or model.FindFirstChild(model,"HumanoidRootPart") :: BasePart?
	if not self._managedModel then
		if hrp then
			hrp.Anchored = true
			model.PrimaryPart = hrp
		end
		local faceYaw = math.rad(DEFAULT_YAW)
		model.PivotTo(		model,CFrame.lookAt(MODEL_LIFT, MODEL_LIFT + Vector3.new(math.sin(faceYaw), 0, math.cos(faceYaw))))
	end

	local parts: { [string]: BasePart } = {}
	if self._managedModel and self._resolveParts then
		parts = self._resolveParts(model) or parts
	else
		for _, name in next, PART_NAMES do
			local part = model.FindFirstChild(model,name)
			if part and part.IsA(part,"BasePart") then
				parts[name] = part
			end
		end
	end

	self._orbitTarget = focusPoint(hrp, parts) or self._orbitTarget

	self._basePlayer.character(model)
	self._basePlayer.hrp(hrp)
	self._basePlayer.parts(parts)

	if self._managedModel then
		self._applyModelState(		self)
		return
	end

	for _, desc in next, model.QueryDescendants(model,"Motor6D") do
		desc.Transform = CFrame.identity
	end

	local animId = self._idleAnimationId
	local humanoid = model.FindFirstChildOfClass(model,"Humanoid")
	if humanoid and animId ~= "" then
		local animator = humanoid.FindFirstChildOfClass(humanoid,"Animator") or instances.new("Animator", {}, humanoid)
		local anim = instances.new("Animation", { AnimationId = animId })
		local track = (animator :: Animator):LoadAnimation(anim)
		if track then
			track.Looped = true
			track.Priority = Enum.AnimationPriority.Idle
			track.Play(			track)
