	self._disable(	self)
	self._janitor:Destroy()
	self._markers:Destroy()
	if self._screenGui then
		self._screenGui:Destroy()
		self._screenGui = nil
	end
	BaseFeature.Destroy(self)
end



























return GrenadeHelper
