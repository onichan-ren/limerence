			janitor,picker.OnUpdate(picker,function(): ()
				self._refreshColor(				self,cat)
			end))

			janitor.Add(
			janitor,materialEl.OnChange(materialEl,function(): ()
				self._refreshCategory(				self,cat)
			end))

			janitor.Add(
			janitor,enabledEl.OnChange(enabledEl,function(): ()
				self._refreshCategory(				self,cat)
			end))
		end
	end
end

function RagdollChams.Disable(self: RagdollChams__DARKLUA_TYPE_xe): ()
	if not self._enabled then
		return
	end
	self._enabled = false

	for ragdoll, record in next, self._ragdolls do
		record.janitor:Destroy()
		self._ragdolls[ragdoll] = nil
	end

	self._restoreAll(
	self)

	if self._activeJanitor then
		self._activeJanitor:Destroy()
		self._activeJanitor = nil
	end
end

function RagdollChams.Destroy(self: RagdollChams__DARKLUA_TYPE_xe): ()
	self.Disable(	self)
	BaseFeature.Destroy(self)
end




return RagdollChams
