		self._refY = refViewport.Y * 0.5
	end

	local rawDelta
	if getAimPoint2d and UserInputService.MouseBehavior == Enum.MouseBehavior.Default then
		local mouseLocation = UserInputService.GetMouseLocation(UserInputService)
