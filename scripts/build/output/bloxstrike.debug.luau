			not hasDiscreteLanes(remainingLanes)
			and rootsWithPendingDiscreteUpdates.has(rootsWithPendingDiscreteUpdates,root)
		then
			rootsWithPendingDiscreteUpdates.delete(			rootsWithPendingDiscreteUpdates,root)
		end
	end

	if root == workInProgressRoot then
		
		workInProgressRoot = nil
		workInProgress = nil
		workInProgressRootRenderLanes = ReactFiberLane.NoLanes
		
		
		
	
end

	
	
	
	
	
