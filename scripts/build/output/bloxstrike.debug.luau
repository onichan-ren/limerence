	if autoSaveSuppressed then
		return
	end
	if not UserController.GetAutoSaveConfigs() then
		return
	end
	local name = activeConfig
	if not name then
		return
	end
	ensureDir()
	writefile(pathFor(name), stateConverter.toJson())
end

