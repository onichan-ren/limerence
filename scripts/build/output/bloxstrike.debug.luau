function Backtrack._enable(self: Backtrack__DARKLUA_TYPE_uc): ()
	if self._enabled then
		return
	end
	self._enabled = true

	self._addedConn = PlayerController.playerAdded:Connect(function(bp: any): ()
		self._bindPlayer(		self,bp)
