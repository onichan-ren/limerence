					end
				end
				break
			end
		end
		sound.Volume = previewVolume
		sound.Parent = SoundService
		sound.Play(		sound)

		self._activeSound = sound

		sound.Ended:Once(function()
			if self._activeSound == sound then
				self._activeSound = nil
				if sub then
					sub.SetActivePreview(					sub,nil)
				end
			end
			sound.Destroy(			sound)
		end)
	end
