local function decodeBombData(model: Model): (number, number)
	local raw = model.GetAttribute(model,"BombPlanted")
	local startedAt = Workspace.GetServerTimeNow(Workspace)
	local duration = 40
	if type(raw) == "string" then
		local decoded = HttpService.JSONDecode(HttpService,raw)
		if type(decoded) == "table" then
			if type(decoded.Time) == "number" then
				startedAt = decoded.Time
			end
			if type(decoded.TimeUntilExplode) == "number" then
				duration = math.max(decoded.TimeUntilExplode, 0.1)
			end
		end
	end
	return startedAt, duration
end

local function findSiteForPosition(position: Vector3): string?
	local bestSite: string? 	
local bestDistance = math.huge
	for _, part: any in next, CollectionService.GetTagged(CollectionService,"PlantArea") do
		if part.IsA(part,"BasePart") then
			local site = part.GetAttribute(part,"Site")
			if site == "A" or site == "B" then
				local distance = (part.Position - position).Magnitude
				if distance < bestDistance then
					bestDistance = distance
					bestSite = site :: string
				end
			end
		end
	end
	return bestSite
end

