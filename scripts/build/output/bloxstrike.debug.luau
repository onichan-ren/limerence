	local redirectionFovRadiusPx = bulletRedirectionOn and fovToPixels(camera, cache.bulletRedirectionFov) or 0
	local triggerFovRadiusPx = triggerOn and fovToPixels(camera, cache.triggerFov) or 0
	local maxFovRadiusPx = math.max(aimFovRadiusPx, triggerFovRadiusPx, redirectionFovRadiusPx)

