		gradient = gradient,
		state = state,
		destroy = function(): ()
			if destroyed then
				return
			end
			destroyed = true
			if _active[frame] then
				_active[frame] = nil
				_activeCount -= 1
			end
			frame.Destroy(			frame)
			teardownSharedLoop()
		end,
	}
