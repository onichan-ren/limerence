local function bindColorpicker(cp: any, atom: any, isRgba: boolean): ()
	local syncing = false

	sub(cp._state, function(color: any)
		if syncing then
			return
		end
		syncing = true
		if isRgba then
			atom({ color, peek(cp._transparency) })
		else
			atom(color)
		end
		syncing = false
	end)

	if isRgba then
		sub(cp._transparency, function(alpha: number?)
			if syncing then
				return
			end
			syncing = true
			atom({ peek(cp._state), alpha })
			syncing = false
		end)
	end

	sub(atom, function(value: any)
		if syncing then
			return
		end
		syncing = true
		if isRgba then
			cp.SetState(			cp,value[1])
			cp.SetTransparency(			cp,value[2])
		else
			cp.SetState(			cp,value)
		end
		syncing = false
	end)
end

local function buildSection(title: string, dict: any): any
	local section = Section(title)

	local keys: { string } = {}
	for key in next, dict do
		table.insert(keys, key)
	end
	table.sort(keys)

	for _, key in next, keys do
		local atom = dict[key]
		if type(atom) ~= "function" then
			continue
		end

		local current = peek(atom)
		local label = camelToTitle(key)

		if typeof(current) == "Color3" then
			local cp = section.AddElement(section,"Colorpicker", label, current)
			bindColorpicker(cp, atom, false)
		elseif type(current) == "table" and typeof(current[1]) == "Color3" then
			local cp = section.AddElement(section,"Colorpicker", label, current[1], current[2])
			bindColorpicker(cp, atom, true)
		end
	end

	return section
end

