			if type(rawPath) == "table" and #rawPath >= 6 then
				local count = #rawPath // 3
				local points = table.create(count)
				for j = 1, count do
					local base = (j - 1) * 3
					points[j] = Vector3.new(rawPath[base + 1], rawPath[base + 2], rawPath[base + 3])
