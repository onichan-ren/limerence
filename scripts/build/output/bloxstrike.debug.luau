		return false
	end
	local instAtom = config.spectateInstance
	if not instAtom then
		return false
	end
	local inst = peek(instAtom)
	if not inst or inst.Player ~= player then
		return false
	end
	if inst.PerspectiveState ~= "First-Person" then
		return false
	end
	return inst.TransparencyState == true
