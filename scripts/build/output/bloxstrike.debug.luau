		local trimmed = string.match(newName, "^%s*(.-)%s*$") or ""
		if lineupStore.Rename(map, oldName, trimmed) then
			NotifyController.Push({ title = "Lineup Renamed", subtext = trimmed, icon = "pencil", duration = 2 })
		end
	end))

	self.Track(
	self,executeKey.OnCallback(executeKey,function(active: boolean): ()
		if active then
			self._beginExecute(			self)
		else
			self._endExecute(			self)
		end
	end))
	self.Track(	self,opts.Watch(opts,"executeKey", function(value: any): ()
		self._holdPrompt = string.format('HOLD %s', tostring(keyLabel(value)))	end))
	self.Track(	self,opts.Watch(opts,"markerColor", function(): ()
		self._applyMarkerColor(		self)
	end))

	self.Track(
	self,worldMapSource.Changed(function(map: string?): ()
		self._map = map
		self._refresh(		self)
	end))
	local storeConn = lineupStore.Changed:Connect(function(map: string): ()
		if map == self._map then
			self._refresh(			self)
		end
	end)
	self.Track(	self,function(): ()
		storeConn.Disconnect(		storeConn)
	end)

	self.Track(
	self,link.Get(link,"grenadeHelper"):OnChange(function(value: boolean): ()
		if value then
			self._enable(			self)
		else
			self._disable(			self)
		end
	end))

	self._refresh(
	self)
	if link.Peek(link,"grenadeHelper") == true then
		self._enable(		self)
	end

	return self
end

function GrenadeHelper._applyMarkerColor(self: GrenadeHelper__DARKLUA_TYPE_z0): ()
	local element: any = self._opts:Get("markerColor")
	if element and element._currentColor then
		self._markers:SetColor((element._currentColor :: any):getValue() :: Color3)
	end
end

function GrenadeHelper._refresh(self: GrenadeHelper__DARKLUA_TYPE_z0): ()
	local map = self._map
	local lineups = map and lineupStore.GetForMap(map) or {}
	self._lineups = lineups

	local character = peek(clientState.character)
	if character then
		groundParams.FilterDescendantsInstances = { character }
	end
	for i = 1, #lineups do
		local lineup = lineups[i]
		local anchor = lineup.anchor or lineup.position
		local hit = Workspace.Raycast(Workspace,anchor, GROUND_RAY, groundParams)
		lineup.markerPos = hit and hit.Position or anchor + GROUND_MISS_DROP

		local eye = lineup.position + EYE_OFFSET
		local aimHit = Workspace.Raycast(Workspace,eye, lineup.direction * AIM_RAY_DIST, groundParams)
		lineup.aimPos = aimHit and aimHit.Position or eye + lineup.direction * AIM_RAY_DIST
	end

	local items = table.create(#lineups)
	for i = 1, #lineups do
		local lineup = lineups[i]
		items[i] = { id = lineup.name, meta = lineup.grenade }
	end
	self._lineupList:SetItems(items)

	if self._enabled then
		self._markers:SetLineups(lineups)
	end
end

function GrenadeHelper._saveLineup(self: GrenadeHelper__DARKLUA_TYPE_z0): ()
	local map = worldMapSource.GetCurrent()
	if not map then
		NotifyController.Push({ title = "Grenade Helper", subtext = "Not in a map", icon = "trash", duration = 2 })
		return
	end
	local parts = peek(clientState.parts)
	local hrp = parts.HumanoidRootPart :: BasePart?
	if not hrp then
		return
	end

	local grenade = grenadePredictionShared.resolveGrenadeName(peek(loadoutState.currentEquipped)) or MOVEMENT_TYPE
	local rawName = self._editor:Peek("lineupName")
	local base = type(rawName) == "string" and string.match(rawName, "^%s*(.-)%s*$") or ""
	if base == "" or base == nil then
		base = grenade
	end

	local humanoid = parts.Humanoid :: Humanoid?
	local name = lineupStore.UniqueName(map, base :: string)
	local velocity = hrp.AssemblyLinearVelocity
	local airborne = isAirborne(parts) or velocity.Y > 2
	lineupStore.Add(map, {
		name = name,
		grenade = grenade,
		throwType = self._editor:Peek("lineupThrow") == "Short Throw" and "Near" or "Far",
		position = hrp.Position,
		direction = Workspace.CurrentCamera.CFrame.LookVector,
		velocity = velocity,
		jump = airborne,
		crouch = humanoid ~= nil and humanoid.GetAttribute(humanoid,"Crouching") == true,
		anchor = Vector3.zero,
	})
	NotifyController.Push({ title = "Lineup Saved", subtext = string.format('%s \u{b7} %s', tostring(name), tostring(grenade)), icon = "saved_config", duration = 2 })
end

function GrenadeHelper._deleteSelected(self: GrenadeHelper__DARKLUA_TYPE_z0): ()
	local map = self._map
	local selected = self._lineupList:GetSelected()
	if not map or type(selected) ~= "string" or selected == "" then
		return
	end
	if lineupStore.Remove(map, selected) then
		NotifyController.Push({ title = "Lineup Deleted", subtext = selected, icon = "trash", duration = 2 })
	end
end

function GrenadeHelper._cancelRecording(self: GrenadeHelper__DARKLUA_TYPE_z0): ()
	self._recording = nil
	if self._recordConn then
		self._recordConn:Disconnect()
		self._recordConn = nil
	end
end

GrenadeHelper._recordTick = LPH_NO_VIRTUALIZE(function(self: GrenadeHelper__DARKLUA_TYPE_z0, dt: number): ()
	local rec = self._recording
	if not rec then
		return
	end
	if not peek(clientState.alive) then
		self._cancelRecording(		self)
		NotifyController.Push({ title = "Grenade Helper", subtext = "Recording cancelled", duration = 1.5 })
		return
	end
	local parts = peek(clientState.parts)
	local hrp = parts.HumanoidRootPart :: BasePart?
	if not hrp then
		self._cancelRecording(		self)
		return
	end

	rec.accum += dt
	if rec.accum < SAMPLE_DT then
		return
	end
	rec.accum -= SAMPLE_DT

	local samples = rec.samples
	samples[#samples + 1] = hrp.Position

	local airborne = isAirborne(parts)
	if airborne and not rec.lastAirborne then
		rec.jumps[#rec.jumps + 1] = #samples
	end
	rec.lastAirborne = airborne

	if not rec.windup then
		local weapon = peek(loadoutState.currentEquipped) :: any
		if weapon and weapon.ThrowStarted == true and not weapon.ThrowFinished then
			rec.windup = #samples
		end
	end

	if #samples >= MAX_SAMPLES then
		self._stopRecording(		self,nil)
	end
end)

function GrenadeHelper._toggleRecording(self: GrenadeHelper__DARKLUA_TYPE_z0): ()
	if self._recording then
		self._stopRecording(		self,nil)
		return
	end
	if not self._enabled then
		NotifyController.Push({ title = "Grenade Helper", subtext = "Enable Grenade Helper first", duration = 2 })
		return
	end
	if self._session then
		return
	end
	local map = worldMapSource.GetCurrent()
	if not map or not peek(clientState.alive) then
		return
	end
	local hrp = peek(clientState.parts).HumanoidRootPart :: BasePart?
	if not hrp then
		return
	end

	self._recording = {
		map = map,
		samples = { hrp.Position },
		jumps = {},
		windup = nil,
		accum = 0,
		lastAirborne = false,
	}
	self._recordConn = RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt: number): ()
		self._recordTick(		self,dt)
	end))
	NotifyController.Push({
		title = "Recording Lineup",
		subtext = "Press again to save, or throw a grenade",
		icon = "point",
		duration = 3,
	})
end

function GrenadeHelper._stopRecording(self: GrenadeHelper__DARKLUA_TYPE_z0, throwData: any?): ()
	local rec = self._recording
	if not rec then
		return
	end
	self._cancelRecording(	self)

	if #rec.samples < MIN_SAMPLES then
		NotifyController.Push({ title = "Grenade Helper", subtext = "Recording too short", duration = 2 })
		return
	end
	if rec.map ~= worldMapSource.GetCurrent() then
		return
	end
	local parts = peek(clientState.parts)
	local hrp = parts.HumanoidRootPart :: BasePart?
	if not hrp then
		return
	end

	local grenade = MOVEMENT_TYPE
	local direction: Vector3
	local velocity: Vector3
	local crouch: boolean
	local throwType: "Far" | "Near" = "Far"
	local windup: number? 
	if throwData then
		grenade = throwData.grenade
		direction = throwData.direction
		velocity = throwData.velocity
		crouch = throwData.crouch
		throwType = throwData.throwType
		windup = rec.windup
	else
		local humanoid = parts.Humanoid :: Humanoid?
		direction = Workspace.CurrentCamera.CFrame.LookVector
		velocity = hrp.AssemblyLinearVelocity
		crouch = humanoid ~= nil and humanoid.GetAttribute(humanoid,"Crouching") == true
	end

	local rawName = self._editor:Peek("lineupName")
	local base = type(rawName) == "string" and string.match(rawName, "^%s*(.-)%s*$") or ""
	if base == "" or base == nil then
		base = grenade
	end
	local name = lineupStore.UniqueName(rec.map, base :: string)

	lineupStore.Add(rec.map, {
		name = name,
		grenade = grenade,
		throwType = throwType,
		position = hrp.Position,
		direction = direction,
		velocity = velocity,
		jump = rec.lastAirborne == true,
		crouch = crouch,
		path = rec.samples,
		pathJumps = #rec.jumps > 0 and rec.jumps or nil,
		pathWindup = windup,
		anchor = Vector3.zero,
	})
	NotifyController.Push({
		title = "Lineup Recorded",
		subtext = string.format('%s \u{b7} %s \u{b7} %s jumps', tostring(name), tostring(grenade), tostring(#rec.jumps)),
		icon = "saved_config",
		duration = 3,
	})
end

function GrenadeHelper._beginExecute(self: GrenadeHelper__DARKLUA_TYPE_z0): ()
	if not self._enabled or self._session or self._recording then
		return
	end
	if not peek(clientState.alive) or peek(clientState.isSpectating) then
		return
	end
	local parts = peek(clientState.parts)
	local hrp = parts.HumanoidRootPart :: BasePart?
	if not hrp then
		return
	end

	local lineups = self._lineups
	local origin = hrp.Position
	local best: Lineup__DARKLUA_TYPE_zX? = self._hovered
	if best then
		local delta = (best.anchor or best.position) - origin
		if delta.Magnitude > START_DIST then
			best = nil
		end
	end
	if not best then
		local bestDist = START_DIST
		for i = 1, #lineups do
			local lineup = lineups[i]
			local delta = (lineup.anchor or lineup.position) - origin
			if math.abs(delta.Y) > MAX_FLOOR_DELTA then
				continue
			end
			local flatDist = math.sqrt(delta.X * delta.X + delta.Z * delta.Z)
			if flatDist < bestDist then
				bestDist = flatDist
				best = lineup
			end
		end
	end

	if not best then
		local now = os.clock()
		if now - self._lastMissNotify > MISS_NOTIFY_COOLDOWN then
			self._lastMissNotify = now
			NotifyController.Push({ title = "Grenade Helper", subtext = "No lineup nearby", duration = 1.5 })
		end
		return
	end

	local lineup = best :: Lineup__DARKLUA_TYPE_zX	local mode = self._opts:Peek("mode") or "Legit"
	local isMovementType = lineup.grenade == MOVEMENT_TYPE
	local savedVel = lineup.velocity
	local horizSpeedSq = savedVel.X * savedVel.X + savedVel.Z * savedVel.Z
	local moving = horizSpeedSq > MOVING_MIN_SPEED * MOVING_MIN_SPEED
	local playback = lineup.path ~= nil and (isMovementType or mode ~= "Rage")
	local runup = not playback and moving and (isMovementType or mode ~= "Rage")
	local runDir = Vector3.zero
	local walkTarget = lineup.position
	if playback then
		walkTarget = lineup.anchor
	elseif runup then
		runDir = Vector3.new(savedVel.X, 0, savedVel.Z).Unit
		walkTarget = lineup.position - runDir * RUNUP_DIST
	end

	local session: Session__DARKLUA_TYPE_z_ = {
		lineup = lineup,
		mode = mode,
		startedAt = os.clock(),
		walkTarget = walkTarget,
		runup = runup,
		playback = playback,
		playIndex = 1,
		nextJump = 1,
		lastAdvanceAt = os.clock(),
		runDir = runDir,
		running = false,
		jumped = false,
		jumpRequestUntil = nil,
		releaseCalled = false,
		prevFlat = nil,
		arrived = false,
		settled = false,
		pinned = false,
		brakeSpeed = nil,
		releaseAt = nil,
		aimed = false,
		aimLoose = false,
		lastAimX = nil,
		lastErrX = nil,
		touchedMove = false,
		throwState = "idle",
		retryAt = 0,
		cancelled = false,
		weapon = nil,
		janitor = Janitor.new(),
	}
	self._session = session

	session.janitor:Add(
		RunService.Stepped:Connect(LPH_NO_VIRTUALIZE(function(_: number, dt: number): ()
			self._moveTick(			self,dt)
		end)),
		"Disconnect"
	)
	session.janitor:Add(function(): ()
		if session.touchedMove then
			local controller = moveController.getActive()
			if controller then
				controller.moveVector = moveController.realMoveVector(controller)
			end
		end
	end, true)
end

function GrenadeHelper._endExecute(self: GrenadeHelper__DARKLUA_TYPE_z0): ()
	local session = self._session
	if not session then
		return
	end
	self._session = nil
	session.cancelled = true

	local weapon = session.weapon
	if session.throwState == "starting" and weapon and weapon.ThrowStarted and not weapon.ThrowFinished then
		self._override = nil
		task.spawn(function(): ()
			setthreadidentity(8)
			weapon.Cancel(			weapon)
		end)
	elseif session.throwState ~= "thrown" then
		self._override = nil
	end

	session.janitor:Destroy()
end

GrenadeHelper._moveTick = LPH_NO_VIRTUALIZE(function(self: GrenadeHelper__DARKLUA_TYPE_z0, dt: number): ()
	local session = self._session
	if not session then
		return
	end
	if not peek(clientState.alive) then
		self._endExecute(		self)
		return
	end
	local parts = peek(clientState.parts)
	local hrp = parts.HumanoidRootPart :: BasePart?
	local controller = moveController.getActive()
	if not hrp or not controller then
		self._endExecute(		self)
		return
	end

	local lineup = session.lineup
	local pos = hrp.Position

	if session.running and session.playback then
		session.touchedMove = true
		local path = lineup.path :: { Vector3 }
		local n = #path
		local idx = session.playIndex
		local now = os.clock()
		while idx < n do
			local sample = path[idx]
			local dx = sample.X - pos.X
			local dz = sample.Z - pos.Z
			if dx * dx + dz * dz > ADVANCE_RADIUS_SQ then
				break
			end
			idx += 1
			session.lastAdvanceAt = now
		end
		session.playIndex = idx

		local jumps = lineup.pathJumps
		if jumps then
			while session.nextJump <= #jumps and jumps[session.nextJump] <= idx do
				session.nextJump += 1
				session.jumpRequestUntil = now + JUMP_REQUEST_WINDOW
			end
		end
		pumpJump(session, now)

		local steerTarget = path[math.min(idx + PATH_LOOKAHEAD, n)]
		local steer = Vector3.new(steerTarget.X - pos.X, 0, steerTarget.Z - pos.Z)
		if steer.Magnitude > 0.1 then
			controller.moveVector = moveController.worldToMoveVector(steer)
		else
			controller.moveVector = Vector3.zero
		end

		local isMovementLineup = lineup.grenade == MOVEMENT_TYPE
		if not isMovementLineup then
			local windup = lineup.pathWindup
			if windup and session.throwState == "idle" and idx >= windup then
				self._attemptThrow(				self,session, true)
			end
			local leadSamples = math.ceil((self._throwDelay[lineup.throwType] or THROW_DELAY_DEFAULT) / SAMPLE_DT)
			if session.throwState == "starting" and not session.releaseCalled and idx >= n - leadSamples then
				self._releaseThrow(				self,session)
			end
		end

		if idx >= n then
			if isMovementLineup then
				self._endExecute(				self)
			elseif session.throwState == "starting" and not session.releaseCalled then
				self._releaseThrow(				self,session)
			end
			return
		end
		if now - session.lastAdvanceAt > PLAYBACK_STALL then
			self._endExecute(			self)
		end
		return
	end

	if session.running then
		session.touchedMove = true
		controller.moveVector = moveController.worldToMoveVector(session.runDir)

		local now = os.clock()
		local toSpot = lineup.position - pos
		local remaining = toSpot.X * session.runDir.X + toSpot.Z * session.runDir.Z
		local vel = hrp.AssemblyLinearVelocity
		local speed = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)

		if lineup.jump and not session.jumped and remaining <= speed * JUMP_LEAD then
			session.jumped = true
			session.jumpRequestUntil = now + JUMP_REQUEST_WINDOW
		end
		pumpJump(session, now)

		if lineup.grenade == MOVEMENT_TYPE then
			if remaining < -1 then
				self._endExecute(				self)
			end
			return
		end

		local throwDelay = self._throwDelay[lineup.throwType] or THROW_DELAY_DEFAULT
		if
			session.throwState == "starting"
			and not session.releaseCalled
			and (remaining <= speed * throwDelay or remaining < -2)
		then
			self._releaseThrow(			self,session)
		end
		if remaining < -OVERRUN_STOP then
			self._endExecute(			self)
		end
		return
	end

	local target = session.walkTarget
	local flat = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)

	if not session.arrived then
		local dist = flat.Magnitude
		local vel = hrp.AssemblyLinearVelocity
		local speed = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
		local prev = session.prevFlat
		local crossed = prev ~= nil and flat.Dot(flat,prev) < 0
		local brakeDist = (speed * speed) / (2 * self._brakeDecel) + speed * dt
		if dist > SNAP_DIST and not crossed and dist > brakeDist then
			session.prevFlat = flat
			session.touchedMove = true
			session.settled = false
			session.pinned = false
			controller.moveVector = moveController.worldToMoveVector(flat)
			return
		end
		session.arrived = true
		session.brakeSpeed = speed
	end

	session.touchedMove = true
	controller.moveVector = Vector3.zero
	local vel = hrp.AssemblyLinearVelocity
	local speedSq = vel.X * vel.X + vel.Z * vel.Z
	local speed = math.sqrt(speedSq)

	local brakeSpeed = session.brakeSpeed
	if brakeSpeed and brakeSpeed > speed and dt > 0 then
		local decel = (brakeSpeed - speed) / dt
		if decel > 5 then
			self._brakeDecel = math.clamp(self._brakeDecel * 0.7 + decel * 0.3, 10, 300)
		end
	end
	session.brakeSpeed = speed

	session.settled = speedSq < SETTLE_SPEED_SQ
	if not session.settled then
		session.pinned = false
		return
	end

	local flatSq = flat.X * flat.X + flat.Z * flat.Z
	if flatSq > GLIDE_MAX_SQ then
		session.arrived = false
		session.prevFlat = nil
		session.pinned = false
		return
	end
	if flatSq > PIN_EPS_SQ then
		local dist = math.sqrt(flatSq)
		local step = math.min(dist, GLIDE_RATE * dt)
		local nx = pos.X + (flat.X / dist) * step
		local nz = pos.Z + (flat.Z / dist) * step
		hrp.CFrame = CFrame.new(nx, pos.Y, nz) * hrp.CFrame.Rotation
		if dist - step > 0.02 then
			session.pinned = false
			return
		end
	end
	session.pinned = true
end)

GrenadeHelper._aimTick = LPH_NO_VIRTUALIZE(function(self: GrenadeHelper__DARKLUA_TYPE_z0, session: Session__DARKLUA_TYPE_z_, dt: number): ()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local direction = session.lineup.direction
	local viewport = camera.ViewportSize
	local camCf = camera.CFrame
	local aimPoint = camCf.Position + direction * 1000
	local screenPos = screenProject.project(camera, viewport, aimPoint)
	local aimTime = self._opts:Peek("aimTime") or 0.5
	local closure = 1 - math.exp(-dt * (4.6 / aimTime))

	if screenPos.Z > 0 then
		local dx = screenPos.X - viewport.X * 0.5
		local dy = screenPos.Y - viewport.Y * 0.5
		local absX = math.abs(dx)
		local absY = math.abs(dy)

		local lastApplied = session.lastAimX
		local lastErr = session.lastErrX
		if lastApplied and lastErr and math.abs(lastApplied) >= 2 then
			local ratio = (lastErr - dx) / lastApplied
			if ratio > 0.05 and ratio < 20 then
				self._aimGain = math.clamp(self._aimGain * 0.7 + ratio * 0.3, 0.2, 5)
			end
		end

		session.aimed = absX < AIM_EPS_PX and absY < AIM_EPS_PX
		session.aimLoose = absX < AIM_LOOSE_PX and absY < AIM_LOOSE_PX
		if session.aimed then
			session.lastAimX = nil
			session.lastErrX = nil
			return
		end

		local stepX = dx * closure
		local stepY = dy * closure
		local stepMag = math.max(math.abs(stepX), math.abs(stepY))
		local minStep = MIN_AIM_RATE * dt
		if stepMag < minStep then
			local errMag = math.max(absX, absY)
			local scale = math.min(minStep, errMag) / math.max(stepMag, 1e-4)
			stepX *= scale
			stepY *= scale
		end
		if math.abs(stepX) > absX then
			stepX = dx
		end
		if math.abs(stepY) > absY then
			stepY = dy
		end

		local gain = self._aimGain
		local mouseX = stepX / gain
		local mouseY = stepY / gain
		mousemoverel(mouseX, mouseY)
		session.lastAimX = mouseX
		session.lastErrX = dx
	else
		local look = camCf.LookVector
		local yawTarget = math.atan2(-direction.X, -direction.Z)
		local yawCurrent = math.atan2(-look.X, -look.Z)
		local dyaw = (yawTarget - yawCurrent + math.pi) % TWO_PI - math.pi
		mousemoverel(math.clamp(-dyaw * COARSE_TURN_SCALE, -COARSE_TURN_CAP, COARSE_TURN_CAP) * closure, 0)
		session.aimed = false
		session.aimLoose = false
		session.lastAimX = nil
		session.lastErrX = nil
	end
end)

function GrenadeHelper._releaseThrow(self: GrenadeHelper__DARKLUA_TYPE_z0, session: Session__DARKLUA_TYPE_z_): ()
	if session.releaseCalled then
		return
	end
	session.releaseCalled = true
	local weapon = session.weapon
	task.spawn(function(): ()
		setthreadidentity(8)
		if weapon.ThrowFinished then
			session.throwState = "thrown"
			return
		end
		if not weapon.ThrowStarted then
			weapon.StartThrow(			weapon)
			task.wait()
		end
		if session.cancelled then
			return
		end
		session.throwState = "thrown"
		session.releaseAt = os.clock()
		weapon.Throw(		weapon,session.lineup.throwType)
	end)
end

function GrenadeHelper._attemptThrow(self: GrenadeHelper__DARKLUA_TYPE_z0, session: Session__DARKLUA_TYPE_z_, deferRelease: boolean): boolean
	local weapon = peek(loadoutState.currentEquipped) :: any
	if grenadePredictionShared.resolveGrenadeName(weapon) ~= session.lineup.grenade then
