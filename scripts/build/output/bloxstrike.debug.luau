function UIController.OpenTab(title: string): boolean
	local tab = UIController.GetTab(title)
	if not tab then
		return false
	end
	local subtabs = peek(tab._subtabs)
	if #subtabs > 0 then
		tab = peek(tab._activeSubtab) or subtabs[1]
	end
	windowState.openTab(tab)
	return true
end

