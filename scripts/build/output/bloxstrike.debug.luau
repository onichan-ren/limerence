end

function ViewmodelChams._applyVisible(self: ViewmodelChams__DARKLUA_TYPE_zr, part: BasePart, entry: PatchEntry__DARKLUA_TYPE_zq): ()
	self._bindPartVisibility(	self,part, entry)
	if not isViewmodelHiddenPart(part) then
		self._applyPartTransparency(		self,part, entry.category)
	end
end

function ViewmodelChams._bindPartVisibility(self: ViewmodelChams__DARKLUA_TYPE_zr, part: BasePart, entry: PatchEntry__DARKLUA_TYPE_zq): ()
	if entry.visibilityConn then
		entry.visibilityConn:Disconnect()
		entry.visibilityConn = nil
	end

	entry.visibilityConn = part.GetPropertyChangedSignal(part,"Transparency"):Connect(function(): ()
		if not self._patched[part] then
			return
		end
		if not isViewmodelHiddenPart(part) then
			self._applyPartTransparency(			self,part, entry.category)
		end
	end)
end

function ViewmodelChams._applyPart(
	self: ViewmodelChams__DARKLUA_TYPE_zr,
	part: BasePart,
	category: CategoryId__DARKLUA_TYPE_zp,
	material: Enum.Material?,
	color: Color3?,
	reflectance: number?
): ()
	if self._patched[part] then
		return
	end
	if not self._categoryEnabled(self,category) then
		return
	end

	local storedTransparency = part.Transparency
	local hidden = partHiddenTransparency(part)
	if hidden ~= nil then
		storedTransparency = hidden
	end

	local entry: PatchEntry__DARKLUA_TYPE_zq = {
		category = category,
		material = part.Material,
		color = part.Color,
		transparency = storedTransparency,
		reflectance = part.Reflectance,
		sa = {},
		visibilityConn = nil,
	}

	for _, child in next, part.GetChildren(part) do
		if child.ClassName == "SurfaceAppearance" then
			entry.sa[#entry.sa + 1] = child
			child.Parent = nil
		end
	end

	if material == nil then
		material = self._categoryMaterial(self,category)
		color = self._categoryColor(self,category)
		reflectance = self._categoryReflectance(self,category)
	end
	part.Material = material
	part.Color = color
	part.Reflectance = reflectance
	self._patched[part] = entry
	self._applyVisible(	self,part, entry)
end

function ViewmodelChams._restorePart(self: ViewmodelChams__DARKLUA_TYPE_zr, part: BasePart): ()
	local entry = self._patched[part]
	if not entry then
		return
	end

	if entry.visibilityConn then
		entry.visibilityConn:Disconnect()
	end

	self._patched[part] = nil

	part.Material = entry.material
	part.Color = entry.color
	part.Transparency = entry.transparency
	part.Reflectance = entry.reflectance

	for _, sa in next, entry.sa do
		sa.Parent = part
	end
end

function ViewmodelChams._refreshCategory(self: ViewmodelChams__DARKLUA_TYPE_zr, category: CategoryId__DARKLUA_TYPE_zp): ()
	local enabled = self._categoryEnabled(self,category)
	local material = self._categoryMaterial(self,category)
	local color = self._categoryColor(self,category)
	local reflectance = self._categoryReflectance(self,category)

	if enabled then
		for part, entry in next, self._patched do
			if entry.category == category then
				part.Material = material
				part.Color = color
				part.Reflectance = reflectance
				self._applyVisible(				self,part, entry)
			end
		end

		local vm = peek(viewmodelState._viewmodel)
		local model = vm and vm.Model
		if model then
			for _, desc in next, model.QueryDescendants(model,"Instance") do
				if classifyPart(desc) == category then
					self._applyPart(					self,desc :: BasePart, category, material, color, reflectance)
				end
			end
		end
	else
		local toRestore: { BasePart } = {}
		for part, entry in next, self._patched do
			if entry.category == category then
				toRestore[#toRestore + 1] = part
			end
		end
		for _, part in next, toRestore do
			self._restorePart(			self,part)
		end
	end
end

function ViewmodelChams._refreshColor(self: ViewmodelChams__DARKLUA_TYPE_zr, category: CategoryId__DARKLUA_TYPE_zp): ()
	local color = self._categoryColor(self,category)
	for part, entry in next, self._patched do
		if entry.category == category then
			part.Color = color
			self._applyVisible(			self,part, entry)
		end
	end
end

function ViewmodelChams._restoreAll(self: ViewmodelChams__DARKLUA_TYPE_zr): ()
	local parts: { BasePart } = {}
	for part in next, self._patched do
		parts[#parts + 1] = part
	end
	for _, part in next, parts do
		self._restorePart(		self,part)
	end
end

function ViewmodelChams._onViewmodelChanged(self: ViewmodelChams__DARKLUA_TYPE_zr, vm: any): ()
	self._restoreAll(	self)

	if self._vmJanitor then
		self._vmJanitor:Destroy()
		self._vmJanitor = nil
	end

	if not vm then
		return
	end

	local model = vm.Model

	if not model then
		return
	end

	self._vmJanitor = Janitor.new()

	local matCache: { [CategoryId__DARKLUA_TYPE_zp]: Enum.Material } = {}
	local colorCache: { [CategoryId__DARKLUA_TYPE_zp]: Color3 } = {}
	local reflectanceCache: { [CategoryId__DARKLUA_TYPE_zp]: number } = {}
	for i = 1, #CATEGORY_ORDER do
		local cat: CategoryId__DARKLUA_TYPE_zp = CATEGORY_ORDER[i]
		matCache[cat] = self._categoryMaterial(self,cat)
		colorCache[cat] = self._categoryColor(self,cat)
		reflectanceCache[cat] = self._categoryReflectance(self,cat)
	end

	for _, desc in next, model.QueryDescendants(model,"Instance") do
		local cat: CategoryId__DARKLUA_TYPE_zp? = classifyPart(desc)
		if cat then
			self._applyPart(			self,desc :: BasePart, cat, matCache[cat], colorCache[cat], reflectanceCache[cat])
		end
	end

	local addedJanitor = self._vmJanitor
	if addedJanitor then
		addedJanitor.Add(
		addedJanitor,			model.DescendantAdded:Connect(function(desc: Instance): ()
				local cat: CategoryId__DARKLUA_TYPE_zp? = classifyPart(desc)
				if cat then
					self._applyPart(					self,desc :: BasePart, cat)
				end
			end),
			"Disconnect"
		)

		addedJanitor.Add(

		addedJanitor,			model.DescendantRemoving:Connect(function(desc: Instance): ()
				if desc.IsA(desc,"BasePart") and self._patched[desc] then
					self._restorePart(					self,desc :: BasePart)
				end
			end),
			"Disconnect"
		)
	end
end

function ViewmodelChams.Enable(self: ViewmodelChams__DARKLUA_TYPE_zr): ()
	if self._enabled then
		return
	end
	self._enabled = true

	local janitor = Janitor.new()
	self._activeJanitor = janitor

	janitor.Add(
	janitor,sub(viewmodelState._viewmodel, function(vm: any): ()
		self._onViewmodelChanged(		self,vm)
	end))

	local settingsLink = self._settingsLink
	if settingsLink then
		for i = 1, #CATEGORY_ORDER do
			local cat: CategoryId__DARKLUA_TYPE_zp = CATEGORY_ORDER[i]
			local picker: any = settingsLink.Get(settingsLink,cat .. "Color")
			local materialEl: any = settingsLink.OnKey(settingsLink,cat .. "MaterialOpts"):Get("material")
			local reflectanceEl: any = settingsLink.OnKey(settingsLink,cat .. "MaterialOpts"):Get("reflectance")
			local enabledEl: any = settingsLink.Get(settingsLink,cat)

			janitor.Add(
			janitor,picker.OnUpdate(picker,function(): ()
				self._refreshColor(				self,cat)
			end))

			janitor.Add(
			janitor,materialEl.OnChange(materialEl,function(): ()
				self._refreshCategory(				self,cat)
			end))

			janitor.Add(
			janitor,reflectanceEl.OnChange(reflectanceEl,function(): ()
				self._refreshCategory(				self,cat)
			end))

			janitor.Add(
			janitor,enabledEl.OnChange(enabledEl,function(): ()
				self._refreshCategory(				self,cat)
			end))
		end
	end

	self._onViewmodelChanged(
	self,peek(viewmodelState._viewmodel))
end

function ViewmodelChams.Disable(self: ViewmodelChams__DARKLUA_TYPE_zr): ()
	if not self._enabled then
		return
	end
	self._enabled = false

	self._restoreAll(
	self)

	if self._vmJanitor then
		self._vmJanitor:Destroy()
		self._vmJanitor = nil
	end

	if self._activeJanitor then
		self._activeJanitor:Destroy()
		self._activeJanitor = nil
	end
end

function ViewmodelChams.Destroy(self: ViewmodelChams__DARKLUA_TYPE_zr): ()
	self.Disable(	self)
	BaseFeature.Destroy(self)
end





return ViewmodelChams
