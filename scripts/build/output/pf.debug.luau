		local eventTime = exports.requestEventTime()
		markRootPinged(root, pingedLanes, eventTime)

		if
			workInProgressRoot == root
			and ReactFiberLane.isSubsetOfLanes(workInProgressRootRenderLanes, pingedLanes)
