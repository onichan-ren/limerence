			local dotHalf = math.floor(dotSize * 0.5)
			parts[#parts + 1] = makeLine(self, -dotHalf, -dotHalf, dotSize, dotSize)
		end

		if opts.Peek(opts,"outline") then
			local outlineThickness = opts.Peek(opts,"outline.outlineThickness") or 1
			for i = 1, #parts do
				parts[i].stroke = instances.new("UIStroke", {
					Thickness = outlineThickness,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					LineJoinMode = Enum.LineJoinMode.Miter,
