local function readManifest(path: string): BeamManifest__DARKLUA_TYPE_wK?
	if not isfile(path) then
		return nil
	end
	local raw = readfile(path)
	if type(raw) ~= "string" then
		return nil
	end
	local decoded: any = HttpService.JSONDecode(HttpService,raw)
	if type(decoded) ~= "table" then
		return nil
	end
	return decoded
end

