function hudState.SetInfo(key: string, text: string?, order: number?): ()
	for i = 1, #entries do
		local entry = entries[i]
		if entry.key == key then
			if text == nil then
				table.remove(entries, i)
				version += 1
			elseif entry.text ~= text then
				entry.text = text
				version += 1
