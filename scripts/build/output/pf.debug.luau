	function(deletions: Array__DARKLUA_TYPE_kW<Fiber__DARKLUA_TYPE_kZ>, fiber: Fiber__DARKLUA_TYPE_kZ, root: FiberRoot__DARKLUA_TYPE_k_, renderPriorityLevel)
		
