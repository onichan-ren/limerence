	local visualsLink = self._visualsLink
	local function trackFovColorpickerColor(relKey: string, assign: (ColorSequence) -> (), _fallback: ColorSequence): ()
		local el = visualsLink.Get(visualsLink,relKey)
		if not el or not el._currentGradient then
			return
