local readConditionFlags = LPH_NO_VIRTUALIZE(function(v: { string }): (boolean, boolean, boolean, boolean, boolean, boolean, boolean, boolean)
	local onlyWhileCanShoot = false
	local whileBlind = false
	local whileInAir = false
	local throughSmokes = false
	local waitForScope = false
	local whileSprinting = false
	local waitForAim = false
	local avoidDeflecting = false
	for _, item in next, v do
		if item == "Only While Can Shoot" then
			onlyWhileCanShoot = true
		elseif item == "While Blind" then
			whileBlind = true
		elseif item == "While In Air" then
			whileInAir = true
		elseif item == "Through Smokes" then
			throughSmokes = true
		elseif item == "Wait For Scope" then
			waitForScope = true
		elseif item == "While Sprinting" then
			whileSprinting = true
		elseif item == "Wait For Aim" then
			waitForAim = true
		elseif item == "Avoid Deflecting" then
			avoidDeflecting = true
		end
	end
	return onlyWhileCanShoot, whileBlind, whileInAir, throughSmokes, waitForScope, whileSprinting, waitForAim, avoidDeflecting
end)

