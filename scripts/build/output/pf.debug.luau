local computeClassicBounds = LPH_NO_VIRTUALIZE(
	function(
		project: (Vector3) -> Vector3,
		hrp: BasePart,
		pixelsPerStudUnit: number,
		halfWidthCoeff: number,
		heightCoeff: number,
		topCoeff: number
