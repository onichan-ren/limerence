		parts[#parts + 1] = makeLine(self, -half, gap, thickness, length)
		parts[#parts + 1] = makeLine(self, -far, -half, length, thickness)
		parts[#parts + 1] = makeLine(self, gap, -half, length, thickness)

		if opts.Peek(opts,"lines.dot") then
