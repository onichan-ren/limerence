	local newState: SuspenseState__DARKLUA_TYPE_hF | nil = finishedWork.memoizedState
	if newState == nil then
		local current = finishedWork.alternate
		if current ~= nil then
			local prevState: SuspenseState__DARKLUA_TYPE_hF | nil = current.memoizedState
