local function getHighestIndex(array: Array__DARKLUA_TYPE_kF<any>)
	local highestIndex = 0
	for k, v in array do
		highestIndex = if k > highestIndex then k else highestIndex
	end
	return highestIndex
end



local function isArrayOrSparseArray(deps: any)
	if type(deps) ~= "table" then
		return false
	end
	for k, _v in deps do
		if type(k) ~= "number" then
			return false
		end
	end
	return true
end

local function mountHookTypesDev()
	if __DEV__ then
		local hookName = (currentHookNameInDev :: any) :: HookType__DARKLUA_TYPE_ky

		if hookTypesDev == nil then
			
			hookTypesDev = ({ hookName } :: any) :: Array__DARKLUA_TYPE_kF<HookType__DARKLUA_TYPE_ky>
		else
			table.insert(hookTypesDev, hookName)
		end
	end
end

function updateHookTypesDev()
	if __DEV__ then
		
		local hookName: HookType__DARKLUA_TYPE_ky = (currentHookNameInDev :: any) :: HookType__DARKLUA_TYPE_ky

		if hookTypesDev ~= nil then
			hookTypesUpdateIndexDev += 1
