			index = i
			break
		end
	end
	table.insert(entries, index, { key = key, order = rank, text = text })
	version += 1
end

function hudState.HasInfo(key: string): boolean
	for i = 1, #entries do
		if entries[i].key == key then
			return true
		end
	end
	return false
end

function hudState.InfoVersion(): number
