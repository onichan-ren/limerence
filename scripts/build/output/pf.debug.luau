				local popEased = popT * popT * (3 - 2 * popT)
				local scale = BEAM_POP_SCALE + (1 - BEAM_POP_SCALE) * popEased
				for _, seg in next, segments do
					seg.beam.Width0 = seg.width0 * scale
					seg.beam.Width1 = seg.width1 * scale
				end
