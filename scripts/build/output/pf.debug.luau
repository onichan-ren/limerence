local function fovToPixels(camera: Camera, fovDegrees: number): number
	local cameraFov = camera.FieldOfView
	if cameraFov <= 0 then
		return 0
	end
	local halfFov = math.min(fovDegrees * 0.5, 89.5)
	local halfCamFov = math.min(cameraFov * 0.5, 89.5)
	return camera.ViewportSize.Y * 0.5 * math.tan(math.rad(halfFov)) / math.tan(math.rad(halfCamFov))
end

