		self.Track(		self,ScopeController.OnChange("trigger.engagement.firstBulletDelay", function(v: any): ()
			cache.triggerFirstBulletDelay = (v or 0) / 1000
			self._userFiredAt = nil
		end))
		if uiOpts.showTriggerBullets ~= false then
			self.Track(			self,ScopeController.OnChange("trigger.engagement.bullets", function(v: any): ()
				cache.triggerBullets = v
			end))
		else
