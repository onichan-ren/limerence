			setHovering(true)
		end,
		[React.Event.MouseLeave] = function()
			setHovering(false)
		end,
		[React.Event.MouseButton1Click] = props.OnClick,
	}, {
		UICorner = e("UICorner", {
			CornerRadius = UDim.new(0, props.Radius or 4),
		}),
		UIStroke = e("UIStroke", {
			Color = hoverBind.map(hoverBind,function(value: number)
				if props.Danger then
					return surfaceStroke.Lerp(surfaceStroke,danger, 0.35 + value * 0.65)
				end
				return props.Primary and accentStrong or surfaceStroke.Lerp(surfaceStroke,accentStrong, value * 0.45)
			end),
