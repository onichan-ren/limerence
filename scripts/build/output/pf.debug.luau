		end))
		self.Track(		self,ScopeController.OnChange("trigger.engagement.shotDelay", function(v: any): ()
			cache.triggerShotDelay = (v or 130) / 1000
		end))
		self.Track(		self,ScopeController.OnChange("trigger.engagement.resetDelay", function(v: any): ()
			cache.triggerResetDelay = (v or 0) / 1000
