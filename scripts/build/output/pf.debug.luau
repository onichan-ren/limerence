function LuauController.Unload(name: string, silent: boolean?): ()
	local handle = handles[name]
	if not handle then
		return
	end
	tearDownHandle(handle)
	handles[name] = nil

	local path = string.format('%s/%s.luau', tostring(LUAUS_DIR), tostring(name))	
if isfile and isfile(path) then
		setScriptInfo(name, {
			name = name,
			status = "discovered",
			error = nil,
			hasTab = false,
		})
	else
		setScriptInfo(name, nil)
	end

	refreshGroupVisibility()

	if not silent then
		NotifyController.Push({
			title = "Unloaded Luau",
			subtext = name,
			icon = "unload",
			duration = 2,
		})
	end
end

function LuauController.Load(name: string, source: string): ()
	if handles[name] then
		return
	end

	local handle: ScriptHandle__DARKLUA_TYPE_ty = {
		name = name,
		tab = nil,
		configKeys = {},
		connections = {},
		elements = {},
		overrides = {},
		findCache = {},
		mounts = {},
		onUnload = Signal.new(),
	}
	handles[name] = handle

	local api = buildApi(handle)
	local result = luauRunner.Run(source, name, api)

	if not result.ok then
		tearDownHandle(handle)
		handles[name] = nil
		setScriptInfo(name, {
			name = name,
			status = "error",
			error = result.error,
			hasTab = false,
		})
		refreshGroupVisibility()
		NotifyController.Push({
			title = string.format("Failed to load Luau '%s'", tostring(name)),
			subtext = result.error,
			icon = "trash",
			duration = 2,
		})
		return
	end

	setScriptInfo(name, {
		name = name,
		status = "loaded",
		error = nil,
		hasTab = handle.tab ~= nil,
	})
	refreshGroupVisibility()
	NotifyController.Push({
		title = "Loaded Luau",
		subtext = name,
		icon = "load",
		duration = 2,
	})
end

function LuauController.Reload(name: string): boolean
	local path = string.format('%s/%s.luau', tostring(LUAUS_DIR), tostring(name))	
if not isfile or not isfile(path) then
		return false
	end
	local ok, source = pcall(readfile, path)
	if not ok or type(source) ~= "string" then
		return false
	end
	LuauController.Load(name, source)
	return true
end

function LuauController.DiscoverFromDisk(): ()
	if not isfolder(LUAUS_DIR) then
		return
	end

	local found: { [string]: boolean } = {}
	for _, path in next, listfiles(LUAUS_DIR) do
		local name = path.match(path,"([^/\\]+)%.luau$")
		if not name then
			continue
		end
		found[name] = true

		local current = peek(luauState.scripts)
		if not current[name] then
			setScriptInfo(name, {
				name = name,
				status = "discovered",
				error = nil,
				hasTab = false,
			})
		end
	end

	local current = peek(luauState.scripts)
	for name, info in next, current do
		if info.status == "discovered" and not found[name] then
			setScriptInfo(name, nil)
		end
	end
end

function LuauController.LoadByName(name: string): boolean
	local path = string.format('%s/%s.luau', tostring(LUAUS_DIR), tostring(name))	
if not isfile(path) then
		setScriptInfo(name, {
			name = name,
			status = "error",
			error = "file not found",
			hasTab = false,
		})
		NotifyController.Push({
			title = string.format("Failed to load Luau '%s'", tostring(name)),
			subtext = "File not found",
			icon = "trash",
			duration = 2,
		})
		return false
	end
	local ok, source = pcall(readfile, path)
	if not ok or type(source) ~= "string" then
		setScriptInfo(name, {
			name = name,
			status = "error",
			error = "failed to read file",
			hasTab = false,
		})
		NotifyController.Push({
			title = string.format("Failed to load Luau '%s'", tostring(name)),
			subtext = "Failed to read file",
			icon = "trash",
			duration = 2,
		})
		return false
	end
	LuauController.Load(name, source)
	return true
end

function LuauController.UnloadAll(): ()
	local names = {}
	for name in next, handles do
		table.insert(names, name)
	end
	for _, name in next, names do
		LuauController.Unload(name, true)
	end
end

