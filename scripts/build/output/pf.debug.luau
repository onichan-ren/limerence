		spawnLineTracer(origin, target, settings, parentJanitor)
	elseif settings.Type == "Adorn" then
		spawnAdornTracer(origin, target, settings, parentJanitor)
	else
		spawnBeamTracer(origin, target, settings, parentJanitor)
	end
end

