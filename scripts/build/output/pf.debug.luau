function commitUnmount(
	finishedRoot: FiberRoot__DARKLUA_TYPE_hE,
	current: Fiber__DARKLUA_TYPE_hD,
	nearestMountedAncestor: Fiber__DARKLUA_TYPE_hD,
	renderPriorityLevel: ReactPriorityLevel__DARKLUA_TYPE_hK
): ()
	onCommitUnmount(current)

	if
		current.tag == FunctionComponent
		or current.tag == ForwardRef
		or current.tag == MemoComponent
		or current.tag == SimpleMemoComponent
		or current.tag == Block
	then
		local updateQueue: FunctionComponentUpdateQueue__DARKLUA_TYPE_hI | nil = current.updateQueue
		if updateQueue ~= nil then
			local lastEffect = (updateQueue :: FunctionComponentUpdateQueue__DARKLUA_TYPE_hI).lastEffect
			if lastEffect ~= nil then
				local firstEffect = lastEffect.next

				local effect = firstEffect
				repeat
					if effect.destroy ~= nil then
						if bit32.band(effect.tag, HookLayout) ~= NoHookEffect then
							if
								enableProfilerTimer
								and enableProfilerCommitHooks
								and bit32.band(current.mode, ProfileMode) ~= 0
							then
								startLayoutEffectTimer()
								safelyCallDestroy(
									current,
									nearestMountedAncestor,
									effect.destroy
								)
								recordLayoutEffectDuration(current)
							else
								safelyCallDestroy(
									current,
									nearestMountedAncestor,
									effect.destroy
								)
							end
						end
					end
					effect = effect.next
				until effect == firstEffect
			end
		end
		return
	elseif current.tag == ClassComponent then
		safelyDetachRef(current, nearestMountedAncestor)
		local instance = current.stateNode
		if typeof(instance.componentWillUnmount) == "function" then
			safelyCallComponentWillUnmount(current, instance, nearestMountedAncestor)
		end
		return
	elseif current.tag == HostComponent then
		safelyDetachRef(current, nearestMountedAncestor)
		return
	elseif current.tag == HostPortal then
		
		
		
		if ReactFiberHostConfig.supportsMutation then
			unmountHostComponents(
				finishedRoot,
				current,
				nearestMountedAncestor,
				renderPriorityLevel
			)
		elseif ReactFiberHostConfig.supportsPersistence then
			unimplemented("emptyPortalContainer")
			
		end
		return
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
	end
end

function commitNestedUnmounts(
	finishedRoot: FiberRoot__DARKLUA_TYPE_hE,
	root: Fiber__DARKLUA_TYPE_hD,
	nearestMountedAncestor: Fiber__DARKLUA_TYPE_hD,
	renderPriorityLevel: ReactPriorityLevel__DARKLUA_TYPE_hK
)
	
	
	
	
	
	local node: Fiber__DARKLUA_TYPE_hD = root
	while true do
		commitUnmount(finishedRoot, node, nearestMountedAncestor, renderPriorityLevel)
		
		
		if
			node.child ~= nil
			
			
			and (not ReactFiberHostConfig.supportsMutation or node.tag ~= HostPortal)
		then
			(node.child :: Fiber__DARKLUA_TYPE_hD).return_ = node
			node = node.child :: Fiber__DARKLUA_TYPE_hD
			continue
		end
		if node == root then
			return
		end
		while node.sibling == nil do
			if node.return_ == nil or node.return_ == root then
				return
			end
			node = node.return_ :: Fiber__DARKLUA_TYPE_hD 
		end
		(node.sibling :: Fiber__DARKLUA_TYPE_hD).return_ = node.return_
		node = node.sibling :: Fiber__DARKLUA_TYPE_hD
	end
end

