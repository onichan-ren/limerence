local function DeleteButton(props: { Show: boolean, OnClick: () -> () }): Element__DARKLUA_TYPE_mW<any>?
	local hidden, setHidden = useState(not props.Show)
	local confirming, setConfirming = useState(false)
	local showBind, showSpring = useSpring(props.Show and 1 or 0, SPRING.smooth)

	useEffect(function()
		if props.Show then
			setHidden(false)
			showSpring.setGoal(			showSpring,1)
			return
		end
		setConfirming(false)
		showSpring.setGoal(		showSpring,0)
		local handle = task.delay(0.2, function()
			setHidden(true)
		end)
		return function()
			task.cancel(handle)
		end
	end, { props.Show })

	useEffect(function()
		if not confirming then
			return
		end
		local handle = task.delay(2.5, function()
			setConfirming(false)
		end)
		return function()
			task.cancel(handle)
		end
	end, { confirming })

	if hidden then
		return nil
	end

	return e("CanvasGroup", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -42, 0.5, 0),
		Size = UDim2.fromOffset(50, 20),
		ClipsDescendants = false,
		GroupTransparency = showBind.map(showBind,function(value: number)
			return 1 - value
		end),
	}, {
		Action = e(ActionButton, {
			Text = confirming and "Confirm" or "Delete",
			Width = 48,
			Height = 18,
			TextSize = 12,
			TextOffsetY = 0,
			Radius = 3,
			Subtle = not confirming,
			Danger = true,
			Position = UDim2.fromOffset(1, 1),
			OnClick = function()
				if confirming then
					props.OnClick()
				else
					setConfirming(true)
				end
			end,
			LayoutOrder = 1,
		}),
	})
end

local function CreatorPanel(props: {
	Source: any,
	OnCancel: () -> (),
	OnCreated: () -> (),
	CollapsedHeight: number,
}): Element__DARKLUA_TYPE_mW<any>
	local creator = props.Source:GetCreator()
	local initial = { name = "" }
	for _, field in next, creator.fields do
		initial[field.key] = field.default or ""
	end
	local values, setValues = useState(initial)
	local errorText, setErrorText = useState(nil :: string?)
	local closing, setClosing = useState(false)
	local closingRef = useRef(false)
	local contentRef = useRef(nil :: GuiObject?)

	local captionColor = useAt(elementColors.caption)
	local panelColor = useAt(elementColors.panel)
	local panelStroke = useAt(elementColors.panelStroke)
	local dangerColor = useAt(themeState.colors.status.danger)
	local titleColor = useAt(subwindowColors.title)
	local enterBind, enterSpring = useSpring(0, SPRING.smooth)
	local heightBind, heightSpring = useSpring(props.CollapsedHeight, SPRING.smooth)
	useEffect(function()
		enterSpring.setGoal(		enterSpring,1)
	end, {})
	useEffect(function()
		local content = contentRef.current
		if not content then
			return
		end
		local function update(): ()
			if not closingRef.current and content.AbsoluteSize.Y > 0 then
				local scale = Charm.peek(dpiState.scale)
				heightSpring.setGoal(				heightSpring,content.AbsoluteSize.Y / math.max(scale, 0.01))
			end
		end
		update()
		local connection = content.GetPropertyChangedSignal(content,"AbsoluteSize"):Connect(update)
		return function()
			connection.Disconnect(			connection)
		end
	end, {})

	local function close(callback: () -> ()): ()
		if closing then
			return
		end
		closingRef.current = true
		setClosing(true)
		enterSpring.setGoal(		enterSpring,0)
		heightSpring.setGoal(		heightSpring,props.CollapsedHeight)
		callback()
	end

	local function setValue(key: string, value: string): ()
		local nextValues = table.clone(values)
		nextValues[key] = value
		setValues(nextValues)
		if errorText then
			setErrorText(nil)
		end
	end

	local fields: { [string]: Element__DARKLUA_TYPE_mW<any> } = {}
	fields.Name = e(FormField, {
		Field = { label = "Name", placeholder = "My custom asset" },
		Value = values.name,
		OnChange = function(value: string)
			setValue("name", value)
		end,
		LayoutOrder = 1,
	})
	for index, field in next, creator.fields do
		fields[string.format('Field_%s', tostring(field.key))] = e(FormField, {
			Field = field,
			Value = values[field.key] or "",
			OnChange = function(value: string)
				setValue(field.key, value)
			end,
			LayoutOrder = index + 1,
		})
	end

	return e("CanvasGroup", {
		BackgroundColor3 = panelColor,
		BorderSizePixel = 0,
		Size = heightBind.map(heightBind,function(value: number)
			return UDim2.new(1, 0, 0, math.floor(value + 0.5))
		end),
		AutomaticSize = Enum.AutomaticSize.None,
		ClipsDescendants = true,
		LayoutOrder = 2,
		GroupTransparency = enterBind.map(enterBind,function(value: number)
			return 1 - value
		end),
		Position = enterBind.map(enterBind,function(value: number)
			return UDim2.fromOffset(0, math.floor((1 - value) * -6))
		end),
	}, {
