Legitbot._subscribeSettings = LPH_NO_VIRTUALIZE(function(self: Legitbot__DARKLUA_TYPE_vw): ()
	local cache = self._cache
	local uiOpts = self._uiOpts
	local showTrigger = (uiOpts.showTrigger ~= false)
	local showRcs = (uiOpts.showRcs ~= false)
	local showAutowall = (uiOpts.showAutowall ~= false)
	local showBulletRedirection = (uiOpts.showBulletRedirection ~= false)

	local function recompute(): ()
		self._recomputeActivations(		self)
	end

	self.Track(
	self,ScopeController.OnChange("legitbot.enabled", function(v: any): ()
		cache.legitbotEnabled = v == true
		recompute()
	end))

	self.Track(
	self,ScopeController.OnChange("aim.enabled", function(v: any): ()
		cache.aimEnabled = v == true
		recompute()
	end))

	if showBulletRedirection then
		if uiOpts.showManipulation then
			self.Track(			self,ScopeController.OnChange("bulletRedirection.manipulation", function(v: any): ()
				cache.bulletRedirectionManipulation = v == true
			end))
		end
		self.Track(		self,ScopeController.OnChange("bulletRedirection.enabled", function(v: any): ()
			cache.bulletRedirectionEnabled = v == true
			recompute()
		end))

		self.Track(
		self,ScopeController.OnChange("bulletRedirection.hitboxes", function(v: any): ()
			cache.bulletRedirectionHitboxes = v
			cache.bulletRedirectionHitboxSet = buildHitboxSetMaybe(v)
			self._unionHitboxesCache = nil
			recompute()
		end))

		self.Track(
		self,ScopeController.OnChange("bulletRedirection.fov", function(v: any): ()
			cache.bulletRedirectionFov = v or 30
			recompute()
		end))

		self.Track(
		self,ScopeController.OnChange("bulletRedirection.chance", function(v: any): ()
			cache.bulletRedirectionChance = v or 100
			local setChance = self._game.setBulletRedirectionChance
			if setChance then
				setChance(cache.bulletRedirectionChance)
			end
		end))
		if showAutowall then
			self.Track(			self,ScopeController.OnChange("bulletRedirection.autowall", function(v: any): ()
				cache.bulletRedirectionAutowall = v == true
			end))
		end
	end

	if showTrigger then
		self.Track(		self,ScopeController.OnChange("trigger.enabled", function(v: any): ()
			cache.triggerEnabled = v == true
			self._triggerLatchedPlayer = nil
			self._triggerOnTargetSince = nil
			self._triggerBurstLeft = nil
			self._triggerBurstAwaitReady = nil
			self._triggerResetUntil = nil
			self._userFiredAt = nil
		end))
	end
	if showRcs then
		self.Track(		self,ScopeController.OnChange("rcs.enabled", function(v: any): ()
			cache.rcsEnabled = v == true
			recompute()
		end))
	end
	self.Track(	self,ScopeController.OnChange("visuals.fieldOfView", function(v: any): ()
		cache.fovVizEnabled = v == true
		recompute()
	end))

	self.Track(
	self,ScopeController.OnChange("aim.targeting.fov", function(v: any): ()
		cache.fov = v or 30
	end))
	self.Track(	self,ScopeController.OnChange("targetting.selection.hitboxes", function(v: any): ()
		cache.hitboxes = v
		cache.hitboxSet = buildHitboxSetMaybe(v)
		self._unionHitboxesCache = nil
	end))
	self.Track(	self,ScopeController.OnChange("targetting.conditions", function(v: any): ()
		if typeof(v) ~= "table" then
			return
		end
		cache.conditions = v
		cache.cnd_onlyWhileCanShoot, cache.cnd_whileBlind, cache.cnd_whileInAir, cache.cnd_throughSmokes, cache.cnd_waitForScope, cache.cnd_whileSprinting, cache.cnd_waitForAim, cache.cnd_avoidDeflecting =
			readConditionFlags(v)
	end))
	self.Track(	self,ScopeController.OnChange("aim.engagement.assistance", function(v: any): ()
		cache.assistance = v or "Assisted"
	end))
	self.Track(	self,ScopeController.OnChange("targetting.selection.reactionTime", function(v: any): ()
		cache.reactionTime = (v or 130) / 1000
	end))
	self.Track(	self,ScopeController.OnChange("targetting.selection.switchDelay", function(v: any): ()
		cache.switchDelay = (v or 90) / 1000
