	local fake = current.fake
	if not fake then
		return nil
	end

	task.wait()

	if not current or current.fake ~= fake then
		return nil
	end

	local tpo = fake.getThirdPersonObject(fake)
	local live = tpo and tpo.getCharacterModel(tpo)
	if typeof(live) ~= "Instance" then
		return nil
	end

	local partSizes = rawget(tpo, "_partSizes") or {}
	local hash = tpo.getCharacterHash(tpo)

	live.Archivable = true
	local liveDesc = live.QueryDescendants(live,"Instance")
	for i = 1, #liveDesc do
		liveDesc[i].Archivable = true
	end
	local clone = live.Clone(live)
	local cloneDesc = clone.QueryDescendants(clone,"Instance")

	local map = {}
	local liveToClone = {}
	for i = 1, #liveDesc do
		local l = liveDesc[i]
		local c = cloneDesc[i]
		if l.IsA(l,"BasePart") and c and c.IsA(c,"BasePart") then
			c.Anchored = true
			c.CanCollide = false
			c.CanQuery = false
			c.CanTouch = false
			c.Massless = true
			c.Size = partSizes[l] or l.Size
			c.CFrame = OFFSET * l.CFrame
			map[#map + 1] = { live = l, clone = c }
			liveToClone[l] = c
		end
	end

	for _, d in next, cloneDesc do
		if d.IsA(d,"Motor6D") or d.IsA(d,"Weld") or d.IsA(d,"WeldConstraint") or d.IsA(d,"Script") or d.IsA(d,"LocalScript") then
			d.Destroy(			d)
		end
	end

	local parts: { [string]: BasePart } = {}
	for _, name in next, PART_NAMES do
		local lp = hash[name]
		local cp = lp and liveToClone[lp]
		if cp then
			parts[name] = cp
		end
	end

	local oldClone = current.clone
	current.clone = clone
	current.map = map
	current.parts = parts
	current.cloneTorso = parts.Torso
	current.weaponModel = fake.getWeaponModel(fake)
	if oldClone then
		oldClone.Destroy(		oldClone)
	end
	setthreadidentity(8)

	return clone :: Model
end

local function build(teamName: string?, weaponName: string?): Model?
	setthreadidentity(8)
	local prev = current

	local fake = FakeCharacter.new({ teamColor = teamColorFor(teamName) })
	fake.update(	fake,Vector3.zero, Vector3.zero, { queryable = false, weaponName = weaponName, stance = "stand" })

	current = { fake = fake, team = teamName or DEFAULT_TEAM }
	local clone = buildClone()
	setthreadidentity(8)
	if not clone then
		fake.destroy(		fake)
		current = prev
		return prev and prev.clone
	end
	if prev then
		if prev.clone then
			prev.clone:Destroy()
		end
		if prev.fake then
			prev.fake:destroy()
		end
	end
	return clone
end

