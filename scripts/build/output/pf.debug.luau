function commitDoubleInvokeEffectsInDEV(fiber: Fiber__DARKLUA_TYPE_kZ, hasPassiveEffects: boolean)
	if __DEV__ and enableDoubleInvokingEffects then
		setCurrentDebugFiberInDEV(fiber)
		invokeEffectsInDev(
