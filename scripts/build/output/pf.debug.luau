function invokeEffectsInDev(
	firstChild: Fiber__DARKLUA_TYPE_kZ,
	fiberFlags: Flags__DARKLUA_TYPE_k7,
	invokeEffectFn: (fiber: Fiber__DARKLUA_TYPE_kZ) -> ()
): ()
	if __DEV__ and enableDoubleInvokingEffects then
		local fiber = firstChild
		while fiber ~= nil do
