			if props.Danger then
				return surface.Lerp(surface,danger, value * 0.16)
			end
			if props.Primary then
				return accent.Lerp(accent,accentStrong, value * 0.18)
			end
			return surface.Lerp(surface,fieldBackgroundActive, value)
		end),
		BackgroundTransparency = hoverBind.map(hoverBind,function(value: number)
			return props.Subtle and (0.35 - value * 0.2) or 0
		end),
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(props.Width or 68, props.Height or 24),
