		vector.dot(vector.create(1, 0.3963377774, 0.2158037573), lab),
		vector.dot(vector.create(1, -0.1055613458, -6.3854172799999995E-2), lab),
		vector.dot(vector.create(1, -8.94841775E-2, -1.291485548), lab)
