		if uiOpts.showMinDamage ~= false then
			self.Track(			self,ScopeController.OnChange("trigger.filters.minDamage", function(v: any): ()
				cache.triggerMinDamage = v or 0
			end))
		else
			cache.triggerMinDamage = 0
		end
		self.Track(		self,ScopeController.OnChange("trigger.magnet", function(v: any): ()
			cache.triggerMagnet = v == true
			if not cache.triggerMagnet then
				self._triggerMagnetSince = nil
			end
		end))
		self.Track(		self,ScopeController.OnChange("trigger.magnet.opts.reactionTime", function(v: any): ()
			cache.triggerMagnetReactionTime = (v or 130) / 1000
		end))
		if uiOpts.showTriggerWaitForScope then
			self.Track(			self,ScopeController.OnChange("trigger.filters.waitForScope", function(v: any): ()
				cache.trg_waitForScope = v == true
			end))
		end
		if uiOpts.showTriggerWaitForAim then
			self.Track(			self,ScopeController.OnChange("trigger.filters.waitForAim", function(v: any): ()
				cache.trg_waitForAim = v == true
			end))
		end
		if uiOpts.showTriggerWaitForCharge then
			self.Track(			self,ScopeController.OnChange("trigger.filters.waitForCharge", function(v: any): ()
