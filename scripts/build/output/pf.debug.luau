				TextSize = LABEL_TEXT_SIZE,
				TextColor3 = labelColor,
				FontFace = FileController.Get("font", "semi_bold"),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				LayoutOrder = 0,
			}),
			R = e(TextField, {
				Text = tostring(r),
				Width = RGB_FIELD_WIDTH,
				Placeholder = "R",
				LayoutOrder = 1,
				OnCommit = function(text: string): boolean
					local n = tonumber(text)
					if n == nil then
						return false
					end
					local ri = math.floor(n + 0.5)
					if ri < 0 or ri > 255 then
						return false
					end
					cp.SetColorFromRGB(					cp,ri, g, b)
					return true
				end,
			}),
			G = e(TextField, {
				Text = tostring(g),
				Width = RGB_FIELD_WIDTH,
				Placeholder = "G",
				LayoutOrder = 2,
				OnCommit = function(text: string): boolean
					local n = tonumber(text)
					if n == nil then
						return false
					end
					local ri = math.floor(n + 0.5)
					if ri < 0 or ri > 255 then
						return false
					end
					cp.SetColorFromRGB(					cp,r, ri, b)
					return true
				end,
			}),
			B = e(TextField, {
				Text = tostring(b),
				Width = RGB_FIELD_WIDTH,
				Placeholder = "B",
				LayoutOrder = 3,
				OnCommit = function(text: string): boolean
					local n = tonumber(text)
					if n == nil then
						return false
					end
					local ri = math.floor(n + 0.5)
					if ri < 0 or ri > 255 then
						return false
					end
					cp.SetColorFromRGB(					cp,r, g, ri)
					return true
				end,
			}),
		}),
	})
