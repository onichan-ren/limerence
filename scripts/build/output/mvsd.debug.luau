	self._janitor:Add(
		LocalPlayer.GetAttributeChangedSignal(		LocalPlayer,"Match"):Connect(function(): ()
			self._evaluate(			self)
		end),
		"Disconnect"
	)

	self._janitor:Add(
		Workspace.GetAttributeChangedSignal(		Workspace,"IsQueuedMatch"):Connect(function(): ()
			self._evaluate(			self)
