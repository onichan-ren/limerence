local function bindColorpicker(cp: any, atom: any, isRgba: boolean): ()
	local syncing = false

	sub(cp._state, function(color: any)
		if syncing then
			return
		end
		syncing = true
		if isRgba then
			atom({ color, peek(cp._transparency) })
		else
			atom(color)
		end
		syncing = false
	end)

	if isRgba then
		sub(cp._transparency, function(alpha: number?)
			if syncing then
				return
			end
			syncing = true
			atom({ peek(cp._state), alpha })
			syncing = false
		end)
	end

	sub(atom, function(value: any)
		if syncing then
			return
		end
		syncing = true
		if isRgba then
			cp.SetState(			cp,value[1])
			cp.SetTransparency(			cp,value[2])
		else
			cp.SetState(			cp,value)
		end
		syncing = false
	end)
