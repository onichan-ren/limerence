			if bit32.band(fiber.flags, fiberFlags) ~= ReactFiberFlags.NoFlags then
				invokeEffectFn(fiber)
			end
			
			fiber = fiber.sibling :: Fiber__DARKLUA_TYPE_kZ
		end
	end
