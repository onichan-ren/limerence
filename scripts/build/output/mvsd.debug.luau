function CharacterEditor.Search(self: CharacterEditor__DARKLUA_TYPE_rg): ()
	local keyword = string.match(peek(self._searchField), "^%s*(.-)%s*$") or ""
	local tab = catalog.getTab(peek(self._category))
	local assetTypes = tab and tab.assetTypes
	local bundleTypes = tab and tab.bundleTypes
	if keyword == "" and tab and tab.keyword then
		keyword = tab.keyword
	end
	local hasAssetTypes = assetTypes and #assetTypes > 0
	local hasBundleTypes = bundleTypes and #bundleTypes > 0
	if keyword == "" and not hasAssetTypes and not hasBundleTypes then
		return
	end
	local sortType = catalog.getSort(peek(self._sortId))
	self._searching(true)
	self._searchPages = nil
	self._searchFinished(false)
	self._searchError(nil)
	local token = {}
	self._searchToken = token
	task.spawn(function(): ()
		local results, err, pages = catalog.search(keyword, assetTypes, bundleTypes, sortType)
		if self._searchToken ~= token then
			return
		end
		self._searching(false)
		self._searchResults(results)
		self._searchError(err)
		if err then
			self._searchErrorNonce(peek(self._searchErrorNonce) + 1)
		end
		self._searchPages = pages
		self._searchFinished(pages == nil)
	end)
end

function CharacterEditor.LoadMore(self: CharacterEditor__DARKLUA_TYPE_rg): ()
	local pages = self._searchPages
	if not pages or peek(self._loadingMore) or peek(self._searchFinished) then
		return
	end
	self._loadingMore(true)
	local token = self._searchToken
	task.spawn(function(): ()
		local more, finished, err = catalog.loadMore(pages)
		self._loadingMore(false)
		if self._searchToken ~= token then
			return
		end
		if err then
			self._searchError(err)
			self._searchErrorNonce(peek(self._searchErrorNonce) + 1)
		end
		if #more > 0 then
			local existing = peek(self._searchResults)
			local combined = table.clone(existing)
			for i = 1, #more do
				combined[#combined + 1] = more[i]
			end
			self._searchResults(combined)
		end
		self._searchFinished(finished)
	end)
end

function CharacterEditor._addBundle(self: CharacterEditor__DARKLUA_TYPE_rg, item: CatalogResult__DARKLUA_TYPE_q4): ()
	local tab = catalog.getTab(peek(self._category))
	local applyParts = tab and tab.applyParts
	local parts = catalog.bundleParts(item.bundledItems)
	if not next(parts) then
		self._setError(		self,"That pack has no body parts.")
		return
	end
	local manifest = table.clone(peek(self._manifest))
	local names = table.clone(manifest.itemNames or {})
	manifest.itemNames = names
	local applied = false
	if applyParts then
		for k = 1, #applyParts do
			local key = applyParts[k]
			if parts[key] then
				manifest[key] = parts[key]
				if item.name then
					names[tostring(parts[key])] = item.name
				end
				applied = true
			end
		end
	else
		for k = 1, #ALL_PART_KEYS do
			local key = ALL_PART_KEYS[k]
			if parts[key] then
				manifest[key] = parts[key]
				if item.name then
					names[tostring(parts[key])] = item.name
				end
				applied = true
			end
		end
	end
	if applied then
		self._manifest(manifest)
		self._setError(		self,nil)
	else
		self._setError(		self,"That pack doesn't include those parts.")
	end
end

function CharacterEditor.AddCatalogItem(self: CharacterEditor__DARKLUA_TYPE_rg, item: CatalogResult__DARKLUA_TYPE_q4): ()
	if item.isBundle then
		self._addBundle(		self,item)
		return
	end
	local id = item.id
	local info = catalog.classify(item.assetTypeName)
	local manifest = table.clone(peek(self._manifest))
	local names = table.clone(manifest.itemNames or {})
	if item.name then
		names[tostring(id)] = item.name
	end
	manifest.itemNames = names
	if info.kind == "accessory" then
		local list: { any } = {}
		local existing = manifest.accessories
		if type(existing) == "table" then
			for i = 1, #existing do
				if existing[i].AssetId == id then
					self._setError(					self,"That item is already added.")
					return
				end
				list[i] = existing[i]
			end
		end
		if #list >= MAX_ACCESSORIES then
			self._setError(			self,string.format('Accessory limit reached (%s).', tostring(MAX_ACCESSORIES)))
			return
		end
		list[#list + 1] = { AccessoryType = info.accessoryType, AssetId = id, IsLayered = info.isLayered == true }
		manifest.accessories = list
	elseif info.kind == "clothing" then
		local key = info.clothingKey :: string
		local unify = UNIFY_PART[key]
		if unify then
			for u = 1, #unify do
				manifest[unify[u] ] = id
			end
		else
			manifest[key] = id
		end
	else
		self._setError(		self,"That item type can't be added.")
		return
	end
	self._manifest(manifest)
	self._setError(	self,nil)
end

function CharacterEditor._removeBundle(self: CharacterEditor__DARKLUA_TYPE_rg, item: CatalogResult__DARKLUA_TYPE_q4): ()
	local parts = catalog.bundleParts(item.bundledItems)
	if not next(parts) then
		return
	end
	local manifest = table.clone(peek(self._manifest))
	for key, id in next, parts do
		if manifest[key] == id then
			manifest[key] = nil
		end
	end
	self._manifest(manifest)
	self._setError(	self,nil)
end

function CharacterEditor.RemoveCatalogItem(self: CharacterEditor__DARKLUA_TYPE_rg, item: CatalogResult__DARKLUA_TYPE_q4): ()
	if item.isBundle then
		self._removeBundle(		self,item)
		return
	end
	local info = catalog.classify(item.assetTypeName)
	if info.kind == "accessory" then
		self.RemoveWornAsset(		self,item.id)
	elseif info.kind == "clothing" then
		local key = info.clothingKey :: string
		local manifest = table.clone(peek(self._manifest))
		local unify = UNIFY_PART[key]
		if unify then
			for u = 1, #unify do
				if manifest[unify[u] ] == item.id then
					manifest[unify[u] ] = nil
				end
			end
		elseif manifest[key] == item.id then
			manifest[key] = nil
		end
		self._manifest(manifest)
	end
	self._setError(	self,nil)
end

function CharacterEditor.RemoveWornAsset(self: CharacterEditor__DARKLUA_TYPE_rg, assetId: number): ()
	local manifest = table.clone(peek(self._manifest))
	local existing = manifest.accessories
	if type(existing) == "table" then
		local list: { any } = {}
		for i = 1, #existing do
			if existing[i].AssetId ~= assetId then
				list[#list + 1] = existing[i]
			end
		end
		manifest.accessories = list
	end
	for i = 1, #STRING_ACCESSORY_KEYS do
		local key = STRING_ACCESSORY_KEYS[i]
		local raw = manifest[key]
		if type(raw) == "string" and raw ~= "" then
			local kept: { string } = {}
			for token in string.gmatch(raw, "%d+") do
				if tonumber(token) ~= assetId then
					kept[#kept + 1] = token
				end
			end
			manifest[key] = #kept > 0 and table.concat(kept, ",") or nil
		end
	end
	self._manifest(manifest)
end

function CharacterEditor.RemoveClothing(self: CharacterEditor__DARKLUA_TYPE_rg, key: string): ()
	local manifest = table.clone(peek(self._manifest))
	manifest[key] = nil
	self._manifest(manifest)
end

function CharacterEditor.Save(self: CharacterEditor__DARKLUA_TYPE_rg): ()
	local source = peek(self._source)
	if not source then
		return
	end
	if not writefile then
		self._setError(		self,"Your executor cannot write files.")
		return
	end

	local name = string.match(peek(self._name), "^%s*(.-)%s*$") or ""
	name = string.gsub(name, "%.json$", "")
	if name == "" then
		self._setError(		self,"This character needs a name. Set one in the picker before opening the editor.")
		return
	end
	if string.find(name, '[<>:"/\\|%?%*]') then
		self._setError(		self,"The name contains characters that cannot be used in a file.")
		return
	end

	local manifest = table.clone(peek(self._manifest))
	manifest.name = name

	local encodeOk, encoded = pcall(function(): string
		return HttpService.JSONEncode(HttpService,manifest)
	end)
	if not encodeOk then
		self._setError(		self,"The character could not be encoded.")
		return
