function AutoQueue._sendQueue(self: AutoQueue__DARKLUA_TYPE_x5): ()
	local remotes = getRemotes()
	local remote = remotes and remotes.FindFirstChild(remotes,"JoinQueue") :: RemoteFunction?
	if not remote then
		self._queued = false
		return
	end

	self._sendToken += 1
	local token = self._sendToken

	task.spawn(function(): ()
		local success = remote.InvokeServer(remote,self._mode)

		if self._sendToken ~= token or not self._enabled then
			return
		end

		if success then
			NotifyController.Push({
				title = "Auto Queue",
				subtext = string.format('Queued for %s.', tostring(self._mode)),
				icon = "aim",
				duration = 3,
			})
			return
		end

		self._queued = false
		task.delay(RETRY_PERIOD, function(): ()
			if self._enabled then
				self._evaluate(				self)
			end
		end)
	end)
end

function AutoQueue._leaveQueue(self: AutoQueue__DARKLUA_TYPE_x5, requeue: boolean?): boolean
	self._sendToken += 1

	if not self._queued then
		return false
	end

	self._queued = false

	local remotes = getRemotes()
	local remote = remotes and remotes.FindFirstChild(remotes,"LeaveQueue") :: RemoteEvent?
	if not remote then
		return false
	end

	if not requeue then
		self._ignoreDequeue += 1
	end

	remote.FireServer(
	remote)
	return requeue == true
end

function AutoQueue._evaluate(self: AutoQueue__DARKLUA_TYPE_x5): ()
	if not self._enabled then
		return
	end

	if inMatch() then
		self._queued = false
		return
	end

	if self._queued then
		return
	end

	if not LocalPlayer.GetAttribute(LocalPlayer,"ProfileLoaded") then
		return
	end

	self._queued = true
	self._sendQueue(	self)
end

function AutoQueue.Enable(self: AutoQueue__DARKLUA_TYPE_x5): ()
	if self._enabled then
		return
	end
	self._enabled = true
	self._queued = false
	self._ignoreDequeue = 0

	self._janitor:Add(
		LocalPlayer.GetAttributeChangedSignal(		LocalPlayer,"ProfileLoaded"):Connect(function(): ()
