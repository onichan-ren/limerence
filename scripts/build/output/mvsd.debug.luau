local function HueFrame(props: { Colorpicker: any, LayoutOrder: number, SnapEpoch: number }): Element__DARKLUA_TYPE_mW<any>
	local cp = props.Colorpicker

	local hue = useAt(cp._hue)
	local hueBind, hueSpring = useSpring(hue, SPRING.snap)

	useEffect(function()
		hueSpring.setGoal(		hueSpring,hue)
	end, { hue })

	useEffect(function()
		if props.SnapEpoch < 1 then
			return
		end
		snapScalarSpring(hueSpring, peek(cp._hue))
	end, { props.SnapEpoch })

	local posBind = hueBind.map(hueBind,function(h: number)
		return UDim2.fromScale(math.clamp(h, 0, 1), 0.5)
	end)
	local anchorBind = hueBind.map(hueBind,function(h: number)
		return Vector2.new(math.clamp(h, 0, 1), 0.5)
	end)
	local colorBind = hueBind.map(hueBind,function(h: number)
		return Color3.fromHSV(h, 1, 1)
	end)

	local onDragStart = useDragValue(function(alpha: Vector2)
		cp.SetHue(		cp,alpha.X)
	end)

	return e("Frame", {
		Size = UDim2.new(1, 0, 0, HUE_HEIGHT),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		LayoutOrder = props.LayoutOrder,
		[React.Event.InputBegan] = function(rbx: Frame, input: InputObject)
			onDragStart(rbx, input)
		end,
	}, {
		UICorner = e("UICorner", {
			CornerRadius = UDim.new(1, 0),
		}),
		UIGradient = e("UIGradient", {
			Color = HUE_GRADIENT,
		}),
		Dragger = e("Frame", {
			BackgroundTransparency = 0,
			BackgroundColor3 = colorBind,
			BorderSizePixel = 0,
			AnchorPoint = anchorBind,
			Position = posBind,
			Size = UDim2.new(0, 8, 0, 8),
		}, {
