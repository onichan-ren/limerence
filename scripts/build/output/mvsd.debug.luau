			{
				AnchorPoint = Vector2.new(1, 0),
				Position = openBind.map(openBind,function(value: number)
					return UDim2.new(1, 0, 1, 4 - (1 - value) * 6)
				end),
				Size = UDim2.new(0, 132, 0, menuHeight),
				BackgroundColor3 = surface,
