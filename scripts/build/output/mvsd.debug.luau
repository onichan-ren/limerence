		if currentFirstChild ~= nil and (currentFirstChild :: Fiber__DARKLUA_TYPE_jU).tag == HostText then
			
			
			deleteRemainingChildren(returnFiber, (currentFirstChild :: Fiber__DARKLUA_TYPE_jU).sibling)
