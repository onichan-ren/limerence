	self._currentTool = nil
	self.character(nil)
	self.hrp(nil)
	self.humanoid(nil)
	self.alive(false)
	self.parts({})
	self.weapon("")
	self.isReloading(false)
	self.cooldowns({})
end

function MvsdPlayer.StartAbilityCooldown(self: MvsdPlayer__DARKLUA_TYPE_uV, id: string, duration: number): ()
	local now = os.clock()
	self.cooldowns(Sift.Dictionary.set(peek(self.cooldowns), id, { started = now, duration = duration }))

	local token = (self._cdTokens[id] or 0) + 1
	self._cdTokens[id] = token
	task.delay(duration, function(): ()
		if self._cdTokens[id] ~= token then
			return
		end
		self.cooldowns(Sift.Dictionary.removeKey(peek(self.cooldowns), id))
	end)
end

function MvsdPlayer.IsAlive(self: MvsdPlayer__DARKLUA_TYPE_uV): boolean
