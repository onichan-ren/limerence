			local r = tonumber(kp[2]) or 0
			local g = tonumber(kp[3]) or 0
			local b = tonumber(kp[4]) or 0
			table.insert(kps, ColorSequenceKeypoint.new(math.clamp(t, 0, 1), Color3.new(r, g, b)))
		end
	end
	if #kps < 2 then
