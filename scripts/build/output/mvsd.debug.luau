		local id = spotifyClientId and spotifyClientId.Peek(spotifyClientId)
		local secret = spotifyClientSecret and spotifyClientSecret.Peek(spotifyClientSecret)
		if type(id) == "string" and id ~= "" and type(secret) == "string" and secret ~= "" then
