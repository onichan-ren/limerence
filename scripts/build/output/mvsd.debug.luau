local function ActionButton(props: ActionButtonProps__DARKLUA_TYPE_qi): Element__DARKLUA_TYPE_mW<any>
	local hovering, setHovering = useState(false)
	local surface = useAt(elementColors.surface)
	local fieldBackgroundActive = useAt(elementColors.fieldBackgroundActive)
	local surfaceStroke = useAt(elementColors.surfaceStroke)
	local accent = useAt(elementColors.accent)
	local accentStrong = useAt(elementColors.accentStrong)
	local text = useAt(elementColors.text)
	local textActive = useAt(elementColors.textActive)
	local danger = useAt(themeState.colors.status.danger)
	local hoverBind, hoverSpring = useSpring(hovering and 1 or 0, SPRING.subtle)
	useEffect(function()
		hoverSpring.setGoal(		hoverSpring,hovering and 1 or 0)
	end, { hovering })
	local buttonTextColor = hoverBind.map(hoverBind,function(value: number)
		if props.Danger then
			return text.Lerp(text,danger, 0.55 + value * 0.45)
		end
		return props.Primary and textActive or text.Lerp(text,textActive, value)
	end)

	return e("TextButton", {
		BackgroundColor3 = hoverBind.map(hoverBind,function(value: number)
			if props.Danger then
				return surface.Lerp(surface,danger, value * 0.16)
			end
			if props.Primary then
				return accent.Lerp(accent,accentStrong, value * 0.18)
			end
			return surface.Lerp(surface,fieldBackgroundActive, value)
		end),
		BackgroundTransparency = hoverBind.map(hoverBind,function(value: number)
			return props.Subtle and (0.35 - value * 0.2) or 0
		end),
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(props.Width or 68, props.Height or 24),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		Text = props.TextOffsetY and "" or props.Text,
		TextColor3 = buttonTextColor,
		TextSize = props.TextSize or 12,
		FontFace = FileController.Get("font", "semi_bold"),
		AutoButtonColor = false,
		Active = false,
		LayoutOrder = props.LayoutOrder,
		[React.Event.MouseEnter] = function()
			setHovering(true)
		end,
		[React.Event.MouseLeave] = function()
			setHovering(false)
		end,
		[React.Event.MouseButton1Click] = props.OnClick,
	}, {
		UICorner = e("UICorner", {
			CornerRadius = UDim.new(0, props.Radius or 4),
		}),
		UIStroke = e("UIStroke", {
			Color = hoverBind.map(hoverBind,function(value: number)
				if props.Danger then
					return surfaceStroke.Lerp(surfaceStroke,danger, 0.35 + value * 0.65)
				end
				return props.Primary and accentStrong or surfaceStroke.Lerp(surfaceStroke,accentStrong, value * 0.45)
			end),
			Thickness = 1,
			Transparency = props.Subtle and 0.25 or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		Label = props.TextOffsetY and e("TextLabel", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, props.TextOffsetY),
			Size = UDim2.fromScale(1, 1),
			Text = props.Text,
			TextColor3 = buttonTextColor,
			TextSize = props.TextSize or 12,
			FontFace = FileController.Get("font", "semi_bold"),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		}) or nil,
	})
end

local function DeleteButton(props: { Show: boolean, OnClick: () -> () }): Element__DARKLUA_TYPE_mW<any>?
	local hidden, setHidden = useState(not props.Show)
	local confirming, setConfirming = useState(false)
	local showBind, showSpring = useSpring(props.Show and 1 or 0, SPRING.smooth)

	useEffect(function()
		if props.Show then
			setHidden(false)
			showSpring.setGoal(			showSpring,1)
			return
		end
		setConfirming(false)
		showSpring.setGoal(		showSpring,0)
		local handle = task.delay(0.2, function()
			setHidden(true)
		end)
		return function()
			task.cancel(handle)
		end
	end, { props.Show })

	useEffect(function()
		if not confirming then
			return
		end
		local handle = task.delay(2.5, function()
			setConfirming(false)
		end)
		return function()
			task.cancel(handle)
		end
	end, { confirming })

	if hidden then
		return nil
	end

	return e("CanvasGroup", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -42, 0.5, 0),
		Size = UDim2.fromOffset(50, 20),
		ClipsDescendants = false,
		GroupTransparency = showBind.map(showBind,function(value: number)
			return 1 - value
		end),
	}, {
		Action = e(ActionButton, {
			Text = confirming and "Confirm" or "Delete",
			Width = 48,
			Height = 18,
			TextSize = 12,
			TextOffsetY = 0,
			Radius = 3,
			Subtle = not confirming,
			Danger = true,
			Position = UDim2.fromOffset(1, 1),
			OnClick = function()
				if confirming then
					props.OnClick()
				else
					setConfirming(true)
				end
			end,
			LayoutOrder = 1,
		}),
	})
end

