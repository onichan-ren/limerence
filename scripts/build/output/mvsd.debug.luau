function MvsdPlayer._onCharacterAdded(self: MvsdPlayer__DARKLUA_TYPE_uV, character: Character__DARKLUA_TYPE_uU): ()
	self._characterJanitor:Cleanup()

	local hrp = character.WaitForChild(character,"HumanoidRootPart", 5) :: BasePart?
	local humanoid = (character.FindFirstChildOfClass(character,"Humanoid") or character.WaitForChild(character,"Humanoid", 5)) :: Humanoid?

	if not hrp or not humanoid then
		return
	end

	if self._player.Character ~= character then
		return
	end

	local parts = {}
	local currentTool: Tool? 	
for _, child in next, character.GetChildren(character) do
		parts[child.Name] = child
		if not currentTool and child.IsA(child,"Tool") then
			currentTool = child
		end
	end
	self.parts(parts)
	self._currentTool = currentTool
	self.weapon(classifyTool(currentTool))

	self.character(character)
	self.hrp(hrp)
	self.humanoid(humanoid)
	self.health(humanoid.Health)
	self.maxHealth(humanoid.MaxHealth)
	self.alive(humanoid.Health > 0)

	self._characterJanitor:Add(character.ChildAdded:Connect(function(part: Instance): ()
		self.parts(Sift.Dictionary.set(peek(self.parts), part.Name :: any, part))
		if part.IsA(part,"Tool") then
			self._currentTool = part :: Tool
			self.weapon(classifyTool(part :: Tool))
		end
	end))

	self._characterJanitor:Add(character.ChildRemoved:Connect(function(part: Instance): ()
		self.parts(Sift.Dictionary.removeKey(peek(self.parts), part.Name :: any))
		if part == (self._currentTool :: Instance?) then
			self._currentTool = nil
		end
		if part.IsA(part,"Tool") and classifyTool(part :: Tool) == peek(self.weapon) then
			self.weapon("")
		end
	end))

	self._characterJanitor:Add(humanoid.HealthChanged:Connect(function(health: number): ()
		self.health(health)
		self.alive(health > 0)
	end))

	self._characterJanitor:Add(humanoid.GetPropertyChangedSignal(humanoid,"MaxHealth"):Connect(function(): ()
		self.maxHealth(humanoid.MaxHealth)
	end))

	self._characterJanitor:Add(humanoid.Died:Connect(function(): ()
		self.alive(false)
	end))
end

function MvsdPlayer._onCharacterRemoving(self: MvsdPlayer__DARKLUA_TYPE_uV): ()
