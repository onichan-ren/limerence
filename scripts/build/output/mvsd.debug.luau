local function makeWeatherPart(size: Vector3, props: { [string]: any }): (Part, ParticleEmitter)
	local part = instances.new("Part", {
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Anchored = true,
		Size = size,
	}, Workspace) :: Part
