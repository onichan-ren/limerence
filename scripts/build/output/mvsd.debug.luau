			if visibleModelAtom and peek(visibleModelAtom) == customCharacter then
				visibleModelAtom(nil)
			end
			customCharacter.Destroy(			customCharacter)
		end

		local function destroyOwned()
			if self._customCharacter == customCharacter then
				table.clear(self._parts)
				table.clear(self._fakeDecals)
				table.clear(self._fakeDecalOriginal)
				table.clear(self._customConstraintInstances)
				table.clear(self._sizeRatios)
				self._customCharacter = nil
				self._fakeHumanoid = nil
				self._fakeRoot = nil
			end
			destroyModel()
		end

		if generation ~= self._generation or not self._enabled then
			destroyModel()
			return
		end

		customCharacterJanitor.Add(
		customCharacterJanitor,function()
			destroyOwned()
		end, true)

		local humanoid = customCharacter.WaitForChild(customCharacter,"Humanoid", 5)

		humanoid.EvaluateStateMachine = false
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

		local animateScript = customCharacter.FindFirstChild(customCharacter,"Animate")
		if animateScript then
			animateScript.Destroy(			animateScript)
		end

		local humanoidRootPart = customCharacter.WaitForChild(customCharacter,"HumanoidRootPart", 5)
		humanoidRootPart.Anchored = true

		self._fakeHidden = true

		customCharacterJanitor.Add(

		customCharacterJanitor,			customCharacter.DescendantAdded:Connect(function(instance: Instance)
				self._processInstance(				self,instance, false)
			end),
			"Disconnect"
		)

		for _, instance in customCharacter.QueryDescendants(customCharacter,"Instance") do
			self._processInstance(			self,instance, false)
		end

		customCharacter.Parent = ensureFolder()

		self._customCharacter = customCharacter
		self._fakeHumanoid = humanoid
		self._fakeRoot = humanoidRootPart
		if modelAtom then
			modelAtom(customCharacter)
		end
	end)
end

