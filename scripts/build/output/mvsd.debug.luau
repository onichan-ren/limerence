local MAX_DEPTH = 6
local MAX_ENTRIES = 100

local function serialize(value: any, seen: { [any]: boolean }, depth: number): string
	local kind = typeof(value)
	if kind == "table" then
		if seen[value] then
			return "<ref>"
		end
		if depth >= MAX_DEPTH then
			return "{...}"
		end
		seen[value] = true
		local parts: { string } = {}
		local count = #value
		local shown = if count > MAX_ENTRIES then MAX_ENTRIES else count
		for i = 1, shown do
			parts[#parts + 1] = serialize(value[i], seen, depth + 1)
		end
		if count > shown then
			parts[#parts + 1] = string.format('...%s more', tostring(count - shown))		
end
		local extra = 0
		for key, entry in next, value do
			local isArrayIndex = type(key) == "number" and key % 1 == 0 and key >= 1 and key <= count
			if not isArrayIndex then
				extra += 1
				if extra > MAX_ENTRIES then
					parts[#parts + 1] = "..."
					break
				end
				local keyText = if type(key) == "string" then key else string.format('[%s]', tostring(serialize(key, seen, depth + 1)))				
parts[#parts + 1] = string.format('%s = %s', tostring(keyText), tostring(serialize(entry, seen, depth + 1)))			
end
		end
		return "{ " .. table.concat(parts, ", ") .. " }"
	elseif kind == "string" then
		return string.format('"%s"', tostring(value))	
elseif kind == "Vector3" then
		return string.format('Vector3(%s, %s, %s)', tostring(value.X), tostring(value.Y), tostring(value.Z))	
elseif kind == "Vector2" then
		return string.format('Vector2(%s, %s)', tostring(value.X), tostring(value.Y))	
elseif kind == "CFrame" then
		local rx, ry, rz = value.ToOrientation(value)
		return string.format('CFrame(%s, %s, %s @ %s, %s, %s)', tostring(value.X), tostring(value.Y), tostring(value.Z), tostring(math.round(math.deg(rx))), tostring(math.round(math.deg(ry))), tostring(math.round(
			math.deg(rz)
		)))	
elseif kind == "Color3" then
		return string.format('Color3(%s, %s, %s)', tostring(math.round(value.R * 255)), tostring(math.round(value.G * 255)), tostring(math.round(value.B * 255)))	
elseif kind == "UDim2" then
		return string.format('UDim2(%s, %s, %s, %s)', tostring(value.X.Scale), tostring(value.X.Offset), tostring(value.Y.Scale), tostring(value.Y.Offset))	
elseif kind == "UDim" then
		return string.format('UDim(%s, %s)', tostring(value.Scale), tostring(value.Offset))	
elseif kind == "Instance" then
		return string.format('%s(%s)', tostring(value.ClassName), tostring(value.GetFullName(value)))	
elseif kind == "EnumItem" then
		return tostring(value)
	else
		return tostring(value)
	end
end

local function format(...: any): string
	local args = table.pack(...)
	if args.n == 0 then
		return ""
	end
	local parts = table.create(args.n)
	for i = 1, args.n do
		local value = args[i]
		parts[i] = if type(value) == "string" then value else serialize(value, {}, 0)
	end
	return table.concat(parts, " ")
end









