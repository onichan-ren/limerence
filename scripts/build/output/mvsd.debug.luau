local HttpService = cloneref(game.GetService(game,"HttpService")) :: HttpService

local BASE_URL = "http://127.0.0.1:26538"
local AUTH_ID = "limerence"
local TOKEN_PATH = "limerence.biz/cache/ytmusic_token.txt"






















local token: string? 
local tokenLoaded = false
local authDenied = false

local function loadToken(): ()
	if tokenLoaded then
		return
	end
	tokenLoaded = true
	if isfile(TOKEN_PATH) then
		local stored = readfile(TOKEN_PATH)
		if type(stored) == "string" and stored ~= "" then
			token = stored
		end
	end
end

local function send(method: string, path: string): HttpResponse__DARKLUA_TYPE_xC?
	local headers: { [string]: string } = {
		["Accept"] = "application/json",
	}
	if token then
		headers["Authorization"] = string.format('Bearer %s', tostring(token))	
end
	local ok, response = pcall(request, {
		Url = BASE_URL .. path,
		Method = method,
		Headers = headers,
	})
	if not ok or type(response) ~= "table" then
		return nil
	end
	return response
end

local function decode(body: string?): any
	if type(body) ~= "string" or body == "" then
		return nil
	end
	local ok, decoded = pcall(function(): any
		return HttpService.JSONDecode(HttpService,body)
	end)
	if not ok then
		return nil
	end
	return decoded
end

local function authenticate(): boolean
	local response = send("POST", string.format('/auth/%s', tostring(AUTH_ID)))
	if not response then
		return false
	end
	local statusCode = response.StatusCode or 0
	if statusCode == 403 then
		authDenied = true
		return false
	end
	if statusCode < 200 or statusCode >= 300 then
		return false
	end
	local decoded = decode(response.Body)
	if type(decoded) ~= "table" or type(decoded.accessToken) ~= "string" then
		return false
	end
	token = decoded.accessToken
	writefile(TOKEN_PATH, decoded.accessToken)
	return true
end

