mod.commitMutationEffectsImpl =
	function(fiber: Fiber__DARKLUA_TYPE_kZ, root: FiberRoot__DARKLUA_TYPE_k_, renderPriorityLevel)
		local flags = fiber.flags
		
		
		
		
		

		if bit32.band(flags, ReactFiberFlags.Ref) ~= 0 then
