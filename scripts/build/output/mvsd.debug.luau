function catalog.search(
	keyword: string,
	assetTypes: { Enum.AvatarAssetType }?,
	bundleTypes: { Enum.BundleType }?,
	sortType: EnumItem?
): ({ CatalogResult__DARKLUA_TYPE_q4 }, string?, CatalogPages?)
	local ok, pages = pcall(function(): CatalogPages
		local params = CatalogSearchParams.new()
		if keyword ~= "" then
			params.SearchKeyword = keyword
		end
		if bundleTypes and #bundleTypes > 0 then
			params.BundleTypes = bundleTypes
		elseif assetTypes and #assetTypes > 0 then
			params.AssetTypes = assetTypes
		end
		if sortType then
			(params :: any).SortType = sortType
			if SORT_AGGREGATION then
				(params :: any).SortAggregation = SORT_AGGREGATION
			end
		end
		return AvatarEditorService.SearchCatalogAsync(AvatarEditorService,params)
	end)
	if not ok then
		return {}, string.format('Catalog search failed: %s', tostring(tostring(pages))), nil
	end
	if not pages then
		return {}, "Catalog search returned nothing.", nil
	end

	local pageOk, page = pcall(function(): { any }
		return pages.GetCurrentPage(pages)
	end)
	if not pageOk or type(page) ~= "table" then
		return {}, "Could not read results.", nil
	end

	return readPage(page), nil, pages
end

function catalog.loadMore(pages: CatalogPages): ({ CatalogResult__DARKLUA_TYPE_q4 }, boolean, string?)
	if pages.IsFinished then
		return {}, true, nil
	end
	local ok, err = pcall(function(): ()
		pages.AdvanceToNextPageAsync(		pages)
	end)
	if not ok then
		return {}, false, string.format('Could not load more: %s', tostring(tostring(err)))	
end
	local pageOk, page = pcall(function(): { any }
		return pages.GetCurrentPage(pages)
	end)
	local finished = pages.IsFinished
	if not pageOk or type(page) ~= "table" then
		return {}, finished, nil
	end
	return readPage(page), finished, nil
end

return catalog
