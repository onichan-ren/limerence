					self._listeners[eventKey](self._instance, ...)
				elseif self._status == EventStatus.Suspended then
					
					

					local argumentCount = select("#", ...)
					table.insert(
						self._suspendedEventQueue,
						{ eventKey, argumentCount, ... }
					)
				end
			end)
		end

		self._listeners[eventKey] = listener
	end
