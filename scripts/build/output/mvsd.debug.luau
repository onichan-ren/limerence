	local alphaBind, alphaSpring = useSpring(props.isInitial and 1 or 0, SPRING.smoothPrecise)

	useEffect(function()
		alphaSpring.setGoal(		alphaSpring,props.isRemoving and 0 or 1)
	end, { props.isRemoving })

	return e("CanvasGroup", {
