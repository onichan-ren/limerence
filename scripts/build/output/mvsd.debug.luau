local function computeBuild(): string
	local scriptName = LP_SCRIPT_NAME :: any
	if scriptName == nil or scriptName == "" then
		return "Dev"
	end
	if string.find(scriptName, "Nightly", 1, true) then
		return "Nightly"
	end
	return "Public"
end

local function fetchGameName(): string
