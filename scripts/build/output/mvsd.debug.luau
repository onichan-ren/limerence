				"Disconnect"
			)
		end

		local joinError = remotes.FindFirstChild(remotes,"OnQueueJoinError") :: RemoteEvent?
		if joinError then
			self._janitor:Add(
				joinError.OnClientEvent:Connect(function(): ()
					self._queued = false
					task.delay(RETRY_PERIOD, function(): ()
						if self._enabled then
							self._evaluate(							self)
						end
					end)
				end),
				"Disconnect"
			)
		end
	end

	self._evaluate(
	self)
end

function AutoQueue.Disable(self: AutoQueue__DARKLUA_TYPE_x5): ()
	if not self._enabled then
		return
	end
	self._enabled = false
	self._leaveQueue(	self)
