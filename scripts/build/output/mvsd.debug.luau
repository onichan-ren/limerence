	local node: Fiber__DARKLUA_TYPE_hD = current

	
	
	local currentParentIsValid = false

	
	local currentParent
	local currentParentIsContainer

	while true do
		if not currentParentIsValid then
			
			local parent = node.return_ :: Fiber__DARKLUA_TYPE_hD
			while true do
				
				if parent == nil then
					error(
						Error.new(
