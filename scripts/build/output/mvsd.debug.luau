	local kps: { NumberSequenceKeypoint } = {}
	for _, kp in next, keypoints do
		if type(kp) == "table" then
			local t = tonumber(kp[1]) or 0
			local v = tonumber(kp[2]) or 0
			table.insert(kps, NumberSequenceKeypoint.new(math.clamp(t, 0, 1), v))
		end
	end
	if #kps < 2 then
